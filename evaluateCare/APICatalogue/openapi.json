                                "schema": {
                                    "$ref": "#/components/schemas/VerifyTokenResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                },
                "x-implementing-class": "VerifyTokenEndpoint",
                "x-implementing-file": "evaluateCare/Code/security/verify_token_endpoint.py"
            }

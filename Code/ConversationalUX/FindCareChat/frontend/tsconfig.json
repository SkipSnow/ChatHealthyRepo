{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": "../../../../",
    "paths": {
      "@providers/*": ["FindCare/ProviderManagement/*"],
      "react": ["Code/ConversationalUX/FindCareChat/frontend/node_modules/@types/react"],
      "react/*": ["Code/ConversationalUX/FindCareChat/frontend/node_modules/@types/react/*"]
    }
  },
  "include": ["src"]
}

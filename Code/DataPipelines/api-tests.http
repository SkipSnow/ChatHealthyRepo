# @name startCountyEnrichment
POST {{baseUrl}}/api/Router
Authorization: {{token}}
Content-Type: application/json

{
    "ChatHealthyTask": "CountyEnrichment",
    "payload": {
        "num_workers": 200,
        "addr_batch_size": 50
    }
}


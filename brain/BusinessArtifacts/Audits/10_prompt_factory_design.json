  "uml_sequence_diagrams": [
    {
      "name": "Provider Search Happy Path",
      "actors": [
        "User",
        "MiddlewareStack",
        "ProviderSearchPromptFactory",
        "ExternalProviderAPI"
      ],
      "sequence": [
        {
          "from": "User",
          "to": "MiddlewareStack",
          "method": "route(input: {query: 'find cardiologist in Richmond'})",
          "return": "processedInput"
        },
        {
          "from": "MiddlewareStack",
          "to": "ProviderSearchPromptFactory",
          "method": "route(processedInput)",
          "return": "providerQuery"
        },
        {
          "from": "ProviderSearchPromptFactory",
          "to": "ExternalProviderAPI",
          "method": "searchProviders(location: 'Richmond', specialty: 'cardiologist')",
          "return": "providerList"
        },
        {
          "from": "ProviderSearchPromptFactory",
          "to": "MiddlewareStack",
          "method": "execute(providerList)",
          "return": "response"
        },
        {
          "from": "MiddlewareStack",
          "to": "User",
          "method": "send(response)",
          "return": "ack"
        }
      ]
    },
    {
      "name": "Conversational/Narrative Question",
      "actors": [
        "User",
        "MiddlewareStack",
        "NarrativePromptFactory",
        "LLMService"
      ],
      "sequence": [
        {
          "from": "User",
          "to": "MiddlewareStack",
          "method": "route(input: {query: 'Tell me about heart disease symptoms'})",
          "return": "processedInput"
        },
        {
          "from": "MiddlewareStack",
          "to": "NarrativePromptFactory",
          "method": "route(processedInput)",
          "return": "narrativePrompt"
        },
        {
          "from": "NarrativePromptFactory",
          "to": "LLMService",
          "method": "generateResponse(prompt: narrativePrompt)",
          "return": "narrativeText"
        },
        {
          "from": "NarrativePromptFactory",
          "to": "MiddlewareStack",
          "method": "execute(narrativeText)",
          "return": "response"
        },
        {
          "from": "MiddlewareStack",
          "to": "User",
          "method": "send(response)",
          "return": "ack"
        }
      ]
    },
    {
      "name": "Clinical Trials",
      "actors": [
        "User",
        "MiddlewareStack",
        "ClinicalTrialsPromptFactory",
        "ClinicalTrialsAPI"
      ],
      "sequence": [
        {
          "from": "User",
          "to": "MiddlewareStack",
          "method": "route(input: {query: 'Are there clinical trials for diabetes in Virginia?'})",
          "return": "processedInput"
        },
        {
          "from": "MiddlewareStack",
          "to": "ClinicalTrialsPromptFactory",
          "method": "route(processedInput)",
          "return": "trialsQuery"
        },
        {
          "from": "ClinicalTrialsPromptFactory",
          "to": "ClinicalTrialsAPI",
          "method": "searchTrials(condition: 'diabetes', location: 'Virginia')",
          "return": "trialsList"
        },
        {
          "from": "ClinicalTrialsPromptFactory",
          "to": "MiddlewareStack",
          "method": "execute(trialsList)",
          "return": "response"
        },
        {
          "from": "MiddlewareStack",
          "to": "User",
          "method": "send(response)",
          "return": "ack"
        }
      ]
    },
    {
      "name": "Emergency/Safety",
      "actors": [
        "User",
        "MiddlewareStack",
        "EmergencyPromptFactory",
        "ComplianceMiddleware"
      ],
      "sequence": [
        {
          "from": "User",
          "to": "MiddlewareStack",
          "method": "route(input: {query: 'I am having chest pain'})",
          "return": "processedInput"
        },
        {
          "from": "MiddlewareStack",
          "to": "EmergencyPromptFactory",
          "method": "route(processedInput)",
          "return": "emergencyPrompt"
        },
        {
          "from": "EmergencyPromptFactory",
          "to": "ComplianceMiddleware",
          "method": "validate(emergencyPrompt)",
          "return": {
            "branch": [
              {
                "condition": "isEmergency",
                "steps": [
                  {
                    "from": "ComplianceMiddleware",
                    "to": "EmergencyPromptFactory",
                    "method": "execute(emergencyPrompt)",
                    "return": "emergencyResponse"
                  }
                ]
              },
              {
                "condition": "notEmergency",
                "steps": [
                  {
                    "from": "ComplianceMiddleware",
                    "to": "EmergencyPromptFactory",
                    "method": "execute(emergencyPrompt)",
                    "return": "standardResponse"
                  }
                ]
              }
            ]
          }
        },
        {
          "from": "EmergencyPromptFactory",
          "to": "MiddlewareStack",
          "method": "execute(response)",
          "return": "finalResponse"
        },
        {
          "from": "MiddlewareStack",
          "to": "User",
          "method": "send(finalResponse)",
          "return": "ack"
        }
      ]
    },
    {
      "name": "Context Carry-Forward Virginia->Richmond",
      "actors": [
        "User",
        "MiddlewareStack",
        "ProviderSearchPromptFactory",
        "ContextMiddleware",
        "ExternalProviderAPI"
      ],
      "sequence": [
        {
          "from": "User",
          "to": "MiddlewareStack",
          "method": "route(input: {query: 'Find a cardiologist in Virginia'})",
          "return": "processedInput"
        },
        {
          "from": "MiddlewareStack",
          "to": "ProviderSearchPromptFactory",
          "method": "route(processedInput)",
          "return": "providerQuery"
        },
        {
          "from": "ProviderSearchPromptFactory",
          "to": "ExternalProviderAPI",
          "method": "searchProviders(location: 'Virginia', specialty: 'cardiologist')",
          "return": "providerList"
        },
        {
          "from": "ProviderSearchPromptFactory",
          "to": "MiddlewareStack",
          "method": "execute(providerList)",
          "return": "response"
        },
        {
          "from": "MiddlewareStack",
          "to": "User",
          "method": "send(response)",
          "return": "ack"
        },
        {
          "from": "User",
          "to": "MiddlewareStack",
          "method": "route(input: {query: 'What about Richmond?'})",
          "return": "processedInput"
        },
        {
          "from": "MiddlewareStack",
          "to": "ContextMiddleware",
          "method": "resolveContext(processedInput, history)",
          "return": "enrichedInput: {location: 'Richmond', specialty: 'cardiologist'}"
        },
        {
          "from": "ContextMiddleware",
          "to": "ProviderSearchPromptFactory",
          "method": "route(enrichedInput)",
          "return": "providerQuery"
        },
        {
          "from": "ProviderSearchPromptFactory",
          "to": "ExternalProviderAPI",
          "method": "searchProviders(location: 'Richmond', specialty: 'cardiologist')",
          "return": "providerList"
        },
        {
          "from": "ProviderSearchPromptFactory",
          "to": "MiddlewareStack",
          "method": "execute(providerList)",
          "return": "response"
        },
        {
          "from": "MiddlewareStack",
          "to": "User",
          "method": "send(response)",
          "return": "ack"
        }
      ]
    },
    {
      "name": "Consent Trigger 5th Message",
      "actors": [
        "User",
        "MiddlewareStack",
        "EpicPromptFactory",
        "ConsentMiddleware"
      ],
      "sequence": [
        {
          "from": "User",
          "to": "MiddlewareStack",
          "method": "route(input: {query: 'User message'})",
          "return": "processedInput"
        },
        {
          "from": "MiddlewareStack",
          "to": "ConsentMiddleware",
          "method": "checkConsent(history)",
          "return": {
            "branch": [
              {
                "condition": "messageCount < 5",
                "steps": [
                  {
                    "from": "ConsentMiddleware",
                    "to": "EpicPromptFactory",
                    "method": "route(processedInput)",
                    "return": "epicPrompt"
                  },
                  {
                    "from": "EpicPromptFactory",
                    "to": "MiddlewareStack",
                    "method": "execute(epicPrompt)",
                    "return": "response"
                  }
                ]
              },
              {
                "condition": "messageCount == 5",
                "steps": [
                  {
                    "from": "ConsentMiddleware",
                    "to": "User",
                    "method": "sendConsentPrompt()",
                    "return": "consentResponse"
                  }
                ]
              }
            ]
          }
        },
        {
          "from": "MiddlewareStack",
          "to": "User",
          "method": "send(response or consentResponse)",
          "return": "ack"
        }
      ]
    },
    {
      "name": "URL Validation on Tool Response",
      "actors": [
        "User",
        "MiddlewareStack",
        "ToolPromptFactory",
        "ValidationMiddleware"
      ],
      "sequence": [
        {
          "from": "User",
          "to": "MiddlewareStack",
          "method": "route(input: {query: 'Show me resources for diabetes'})",
          "return": "processedInput"
        },
        {
          "from": "MiddlewareStack",
          "to": "ToolPromptFactory",
          "method": "route(processedInput)",
          "return": "toolPrompt"
        },
        {
          "from": "ToolPromptFactory",
          "to": "ValidationMiddleware",
          "method": "validateURLs(toolPrompt.response)",
          "return": {
            "branch": [
              {
                "condition": "allURLsValid",
                "steps": [
                  {
                    "from": "ValidationMiddleware",
                    "to": "MiddlewareStack",
                    "method": "execute(toolPrompt.response)",
                    "return": "response"
                  }
                ]
              },
              {
                "condition": "invalidURLFound",
                "steps": [
                  {
                    "from": "ValidationMiddleware",
                    "to": "ToolPromptFactory",
                    "method": "handleInvalidURL()",
                    "return": "correctedResponse"
                  },
                  {
                    "from": "ToolPromptFactory",
                    "to": "MiddlewareStack",
                    "method": "execute(correctedResponse)",
                    "return": "response"
                  }
                ]
              }
            ]
          }
        },
        {
          "from": "MiddlewareStack",
          "to": "User",
          "method": "send(response)",
          "return": "ack"
        }
      ]
    }
  ],

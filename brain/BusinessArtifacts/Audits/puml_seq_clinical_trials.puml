@startuml
title 5.3 Clinical Trials Search
skinparam shadowing false
skinparam defaultFontSize 10

actor User
participant "FindCareApp" as UI
participant "PromptDispatcher" as Dispatcher
participant "SafetyMiddleware" as SafeMW
participant "EvaluateCarePromptFactory" as ECPF
participant "EvaluateCareFacade" as ECF
participant "ClinicalTrialsService" as CTS
participant "Google Routes API" as Google
participant "ClinicalTrials.gov" as CTGov
participant "ValidationMiddleware" as ValMW

User -> UI: "Find clinical trials for\ndiabetes near Richmond VA"
UI -> Dispatcher: dispatch(PromptInput)

Dispatcher -> SafeMW: process(input, next)
SafeMW -> SafeMW: is_emergency → false

SafeMW -> ECPF: route(input)
ECPF -> ECPF: classify intent
note right: Deterministic rule:\n"clinical trial" keyword\n→ CLINICAL_TRIALS_SEARCH
ECPF --> SafeMW: PromptRoute(epic="evaluatecare",\nintent="clinical_trials")

SafeMW -> ECPF: execute(input)

ECPF -> ECF: search_clinical_trials(\n  condition="diabetes",\n  location="Richmond VA",\n  user_location="Richmond, VA",\n  max_results=5)

ECF -> CTS: search(\n  condition="diabetes",\n  location="Richmond VA",\n  user_location="Richmond, VA")

CTS -> CTGov: GET /studies?\n  query.cond=diabetes\n  &filter.overallStatus=RECRUITING\n  &pageSize=5
CTGov --> CTS: {studies: [{nctId, title,\nphase, locations, ...}]}

CTS -> CTS: extract site addresses\nfrom trial locations

CTS -> Google: Routes API\norigin="Richmond, VA"\ndestinations=[site addresses]
Google --> CTS: {routes: [{distance, duration}]}

CTS -> CTS: attach travel_info\nto each trial
CTS --> ECF: {trials: [\n  {nct_id, title, phase,\n   status: "Recruiting",\n   locations: [...],\n   travel_info: {distance, duration},\n   url: "https://clinicaltrials.gov/..."\n  }, ...]}

ECF --> ECPF: {trials: [...]}

ECPF -> ECPF: build PromptOutput
ECPF --> SafeMW: PromptOutput(\n  response_type="structured",\n  trials=[...],\n  text="Found 5 recruiting trials\n  for diabetes near Richmond")

SafeMW --> ValMW: output
ValMW -> ValMW: guard_text — validate\nclinicaltrials.gov URLs
ValMW --> Dispatcher: output

Dispatcher --> UI: PromptOutput
UI -> UI: detect trials in output
UI -> UI: render trial cards\nwith travel times
UI -> User: 5 trials displayed\nwith distances

@enduml

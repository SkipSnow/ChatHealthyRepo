@startuml
title ChatHealthy FindCare — Prompt Factory Architecture\nClass Diagram
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontSize 9
skinparam padding 2
skinparam nodesep 12
skinparam ranksep 20

' ═══════════════════════════════════════════
' NEW — Prompt Factory Layer
' ═══════════════════════════════════════════

package "Prompt Factory (NEW)" #DDFFDD {

  interface IPromptFactory <<interface>> {
    +route(input: PromptInput): PromptRoute
    +execute(input: PromptInput): PromptOutput
  }

  class PromptDispatcher {
    -_registry: dict[str, IPromptFactory]
    +dispatch(input: PromptInput): PromptOutput
    +register(epic_id: str, factory: IPromptFactory): void
  }

  class PromptInput {
    +user_message: str
    +prompt_history: list[dict]
    +user_context: dict
    +session_state: SessionState
    +ip: str
  }

  class PromptOutput {
    +response_type: "structured" | "narrative"
    +text: Optional[str]
    +providers: Optional[list[dict]]
    +trials: Optional[list[dict]]
    +pagination: Optional[PaginationMeta]
    +emergency: bool
    +consent_required: bool
  }

  class PromptRoute {
    +epic_id: str
    +intent: str
    +confidence: float
    +deterministic: bool
  }

  class SessionState {
    +message_count: int
    +last_state: Optional[str]
    +last_specialty: Optional[str]
    +last_city: Optional[str]
    +is_locked: bool
    +consent_tier: Optional[str]
  }
}

' ═══════════════════════════════════════════
' NEW — Middleware Stack
' ═══════════════════════════════════════════

package "Middleware (NEW)" #FFDDDD {

  class SafetyMiddleware {
    -_safety: SafetyService
    +process(input: PromptInput, next: callable): PromptOutput
  }

  class HistoryMiddleware {
    +process(input: PromptInput, next: callable): PromptOutput
  }

  class ContextMiddleware {
    -_me_context: dict
    -_prompt_maker: PromptSystemMaker
    +process(input: PromptInput, next: callable): PromptOutput
  }

  class ConsentMiddleware {
    -_consent: ConsentService
    -_lead: LeadService
    +process(input: PromptInput, next: callable): PromptOutput
  }

  class ValidationMiddleware {
    -_url_guardian: URLGuardian
    +process(input: PromptInput, next: callable): PromptOutput
  }

  class ComplianceMiddleware {
    +process(input: PromptInput, next: callable): PromptOutput
  }
}

' ═══════════════════════════════════════════
' NEW — Epic Facades (implement IPromptFactory)
' ═══════════════════════════════════════════

package "Epic Facades (NEW)" #DDDDFF {

  class FindCarePromptFactory {
    -_find_care: FindCareService
    -_specialty: SpecialtyService
    -_tool_router: ToolRouter
    +route(input: PromptInput): PromptRoute
    +execute(input: PromptInput): PromptOutput
  }

  class EvaluateCarePromptFactory {
    -_facade: EvaluateCareFacade
    +route(input: PromptInput): PromptRoute
    +execute(input: PromptInput): PromptOutput
  }

  class SafetyPromptFactory {
    -_safety: SafetyService
    +route(input: PromptInput): PromptRoute
    +execute(input: PromptInput): PromptOutput
  }

  class NarrativePromptFactory {
    -_about: AboutService
    -_unknown: UnknownQuestionService
    -_llm: llm_client
    +route(input: PromptInput): PromptRoute
    +execute(input: PromptInput): PromptOutput
  }

  class CompliancePromptFactory {
    +route(input: PromptInput): PromptRoute
    +execute(input: PromptInput): PromptOutput
  }
}

' ═══════════════════════════════════════════
' EXISTING — Domain Services (unchanged)
' ═══════════════════════════════════════════

package "Domain Services (EXISTING)" #FFFFDD {

  class FindCareService <<existing>> {
    -_get_db: callable
    -_env: str
    -_get_embedding: callable
    -_specialty: SpecialtyService
    +search_providers(specialty_query, state, city, ...): dict
    +identify_specialty(query: str): dict
    -_facet_query(collection, filter, after_npi, limit): tuple
    -_vector_search(embedding, state, city, county, limit): list
    -_build_summary_message(...): str
    -_format_provider(p: dict): dict
  }

  class SpecialtyService <<existing>> {
    -_get_db: callable
    -_env: str
    -_get_vector: callable
    +find_specialty_codes(query: str, chat_history: list): dict
  }

  class SafetyService <<existing>> {
    -_get_db: callable
    -_keywords: list[str]
    -_openai_key: str
    +is_emergency(message: str): bool
    +is_ip_locked(ip: str): bool
    +lock_ip(ip: str, trigger: str, history: list): bool
    +try_admin_unlock(message: str, ip: str): bool
  }

  class ConsentService <<existing>> {
    -_anthropic_key: str
    +summarize_conversation(history: list): str
    +de_identify(history: list): void
  }

  class LeadService <<existing>> {
    -_get_db: callable
    -_consent: ConsentService
    -_push: callable
    +record_user_details(email, name, ...): dict
  }

  class UnknownQuestionService <<existing>> {
    -_consent: ConsentService
    +record(question, question_class, consent, ...): dict
  }

  class AboutService <<existing>> {
    -_me: dict
    +get_skip_snow_context(): dict
    +get_chathealthy_context(): dict
  }

  class URLGuardian <<existing>> {
    -_cache: dict
    +guard_text(text: str): str
    -_validate(url: str, context: str): tuple
    -_validate_batch(urls, context): dict
  }
}

' ═══════════════════════════════════════════
' EXISTING — Application Layer (unchanged)
' ═══════════════════════════════════════════

package "Application (EXISTING)" #FFE4CC {

  class ToolRouter <<existing>> {
    -_registry: dict[str, callable]
    -_models: dict[str, type]
    +register(name: str, handler: callable, model: type): void
    +dispatch(name: str, args: dict): dict
    +handle_normalized_tool_calls(calls, messages, fmt_fn): list
  }

  class EvaluateCareFacade <<existing>> {
    -_clinical_trials: ClinicalTrialsService
    -_provider_detail: ProviderDetailService
    +search_clinical_trials(condition, location, ...): dict
    +get_provider_details(name, npi, state): dict
  }

  class ClinicalTrialsService <<existing>> {
    -_api_key: str
    +search(condition, location, user_location, max): dict
    -_get_travel_info(origin, destinations): dict
  }

  class ProviderDetailService <<existing>> {
    +lookup(provider_name, npi, state): dict
  }
}

' ═══════════════════════════════════════════
' EXISTING — Infrastructure (unchanged)
' ═══════════════════════════════════════════

package "Infrastructure (EXISTING)" #E8E8E8 {

  class PromptSystemMaker <<existing>> {
    -_brain: Path
    -_env: str
    +build_system_prompt(...): str
    +load_tool_definitions(): list[dict]
    +load_emergency_keywords(): list[str]
    +load_me_context(me_dir: str): dict
  }

  class EmbeddingClient <<existing>> {
    +get_query_embedding(text: str): list[float]
    +get_specialty_vector(text: str): list[float]
  }

  class "llm_client (module)" as llm_client <<existing>> {
    +chat(model, messages, tools, system, ...): dict
  }
}

' ═══════════════════════════════════════════
' Relationships
' ═══════════════════════════════════════════

' Interface implementations
FindCarePromptFactory ..|> IPromptFactory
EvaluateCarePromptFactory ..|> IPromptFactory
SafetyPromptFactory ..|> IPromptFactory
NarrativePromptFactory ..|> IPromptFactory
CompliancePromptFactory ..|> IPromptFactory

' Dispatcher uses
PromptDispatcher --> IPromptFactory : dispatches to
PromptDispatcher --> PromptInput : receives
PromptDispatcher --> PromptOutput : returns

' Epic facades use existing services
FindCarePromptFactory --> FindCareService
FindCarePromptFactory --> SpecialtyService
FindCarePromptFactory --> ToolRouter
EvaluateCarePromptFactory --> EvaluateCareFacade
SafetyPromptFactory --> SafetyService
NarrativePromptFactory --> AboutService
NarrativePromptFactory --> UnknownQuestionService
NarrativePromptFactory --> llm_client

' Middleware uses existing services
SafetyMiddleware --> SafetyService
ConsentMiddleware --> ConsentService
ConsentMiddleware --> LeadService
ValidationMiddleware --> URLGuardian
ContextMiddleware --> PromptSystemMaker

' Existing relationships
EvaluateCareFacade --> ClinicalTrialsService
EvaluateCareFacade --> ProviderDetailService
FindCareService --> SpecialtyService
LeadService --> ConsentService
UnknownQuestionService --> ConsentService
SpecialtyService --> EmbeddingClient

@enduml

@startuml
title 5.7 URL Validation on Tool Response
skinparam shadowing false
skinparam defaultFontSize 10

actor User
participant "PromptDispatcher" as Dispatcher
participant "NarrativePromptFactory" as NPF
participant "llm_client" as LLM
participant "ToolRouter" as TR
participant "ProviderDetailService" as PDS
participant "ValidationMiddleware" as ValMW
participant "URLGuardian" as UG

User -> Dispatcher: "Tell me about Dr. Smith\nNPI 1234567890"

Dispatcher -> NPF: route + execute

NPF -> LLM: chat(model="gpt-4.1",\nmessages, tools, system)
LLM --> NPF: tool_use: lookup_provider_external\n{provider_name: "Dr. Smith",\nnpi: "1234567890"}

NPF -> TR: dispatch("lookup_provider_external",\n{provider_name, npi})
TR -> PDS: lookup("Dr. Smith", "1234567890")
PDS -> PDS: query NPI Registry API
PDS -> PDS: construct research URLs
PDS --> TR: {provider_name: "Dr. Smith",\nnpi_details: {...},\nresearch_sites: {\n  healthgrades: "https://healthgrades.com/...",\n  npi_registry: "https://npiregistry.cms.hhs.gov/...",\n  state_board: "https://..."}}
TR --> NPF: tool result

NPF -> LLM: chat(messages + tool_result)
LLM --> NPF: "Here's what I found about\nDr. Smith:\n- [Healthgrades profile](https://healthgrades.com/...)\n- [NPI Registry](https://npiregistry.cms.hhs.gov/...)\n- [Virginia Board](https://dhp.virginia.gov/...)"

NPF -> NPF: build PromptOutput(\n  response_type="narrative",\n  text=LLM response)
NPF --> ValMW: output

' URL Validation in middleware
ValMW -> UG: guard_text(text)

UG -> UG: extract URLs from text
note right: Found 3 URLs:\n1. healthgrades.com/...\n2. npiregistry.cms.hhs.gov/...\n3. dhp.virginia.gov/...

UG -> UG: _validate_batch(urls)

group Healthgrades URL
  UG -> UG: trusted domain\n→ SKIP validation
  note right: Healthgrades URLs are\nconstructed by us, not LLM
end

group NPI Registry URL
  UG -> UG: HEAD request → 200
  UG -> UG: SPA domain → trust 200
  note right: NPI Registry is SPA.\n200 doesn't prove content.\nTrust it (known behavior).
end

group State Board URL
  UG -> UG: HEAD request → 200
  UG -> UG: _ai_verify_content(\n  url, context="Virginia medical board",\n  page_content)
  note right: Claude Haiku verifies\npage content matches expected\nmedical board content → OK
end

UG --> ValMW: sanitized text\n(all URLs valid, unchanged)

alt If URL was broken
  UG -> UG: HEAD request → 404
  UG -> UG: _find_correct_url(\n  broken_url, context)
  note right: Google Custom Search\nfor correct URL\n→ AI verify result
  UG -> UG: replace broken URL\nor defang (remove link,\nkeep text)
end

ValMW --> Dispatcher: output
Dispatcher --> User: response with\nvalidated URLs

@enduml

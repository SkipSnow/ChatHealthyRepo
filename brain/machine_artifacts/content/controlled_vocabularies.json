    {
      "vocabulary_id": "CV-007",
      "name": "governance_propensity",
      "definition": "Immutable governance response labels. Five levels spanning two scopes (system and session). Each label maps to a fixed propensity. Used in the governance matrix — every cell in the matrix must be one of these five values. Labels are subjective assignments today — research story pending to validate each cell.",
      "members": [
        {
          "value": "escalate",
          "definition": "Escalate to a higher authority. The current scope cannot resolve this — requires human intervention or a higher-level governance decision.",
          "risk_level": "not_a_problem",
          "reason": "Required to make governance framework functional and automated.",
          "ch_matrix_id": "a1c2d3e4-0000-4000-b000-000000000099"
        },
        {
          "value": "system_abend",
          "definition": "System-level abend. All users, all sessions, all environments stop. The system is non-compliant and must not serve until resolved. Flag set globally — every hook returns continue:false. GOV-015: governance is universal and immediate.",
          "ch_matrix_id": "f985b164-2928-4e21-a3de-3015747404fc"
        },
        {
          "value": "session_abend",
          "definition": "Session-level abend. This Claude session stops (continue:false). System keeps running. Other users unaffected. The session violated a constraint that cannot be recovered within the session.",
          "ch_matrix_id": "035dfe40-ecce-4daa-81dd-afcc062ddbc9"
        },
        {
          "value": "environment_abend",
          "definition": "Environment-aware abend. Check current environment context. Abend if the constraint applies in this environment.",
          "ch_matrix_id": "9e153de8-8a56-490f-85f0-0c4753b3288e"
        },
        {
          "value": "system_warning",
          "definition": "System-level warning. Logged system-wide. Boss alerted. All sessions see it. Proceed with caution. The constraint is at risk across the system.",
          "ch_matrix_id": "03bf5b52-7990-47ec-aef3-9e393a61eeaf"
        },
        {
          "value": "session_warning",
          "definition": "Session-level warning. Logged locally to this session. Claude proceeds with caution. The constraint is relevant but not blocking.",
          "ch_matrix_id": "ea31964d-eba4-4e35-80a5-f7d2eb8f672d"
        },
        {
          "value": "environment_warning",
          "definition": "Environment-aware warning. Check current environment context. Warn if the constraint applies in this environment.",
          "ch_matrix_id": "6608431a-6bc3-4085-ab28-4f765689a045"
        },
        {
          "value": "environment_display",
          "definition": "Environment-aware display. Show environment context to the user (e.g. red dev banner). Not a warning or risk — presentation behavior.",
          "ch_matrix_id": "fd34a16d-813e-4705-bcce-20dbbdccba49"
        },
        {
          "value": "allow",
          "definition": "Good event. Proceed. No action needed. The constraint is either not relevant or fully satisfied.",
          "ch_matrix_id": "4abb6ff7-3f0e-471b-9579-62ef084bab75"
        },
        {
          "value": "code_controlled",
          "definition": "Behavior is enforced by code. When the governance grid cell has this value, the code implements the specific control sequence defined in the engineering rules — not a generic abend or warning. The code must execute the exact procedure specified in the rule (e.g. v4-004 control sequence: stop, state the violation, request one-time authority, log risk acceptance).",
          "risk_level": "not_a_problem",
          "reason": "These additions to the vocabulary (code_controlled, not_a_problem) are required in order to make our governance framework functional and automated.",
          "ch_matrix_id": "a1c2d3e4-0000-4000-b000-000000000100"
        },
        {
          "value": "not_a_problem",
          "definition": "No risk. Used as a risk_level value when a governance action carries no operational, compliance, or security risk.",
          "risk_level": "not_a_problem",
          "reason": "These additions to the vocabulary (code_controlled, not_a_problem) are required in order to make our governance framework functional and automated.",
          "ch_matrix_id": "a1c2d3e4-0000-4000-b000-000000000101"
        }
      ],
      "invoked_by": {

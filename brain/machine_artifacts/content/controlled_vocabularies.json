    {
      "vocabulary_id": "CV-008",
      "name": "bug_type",
      "definition": "Constrained severity/type values for bug records in bugs.json. Every bug must have exactly one type.",
      "risk_level": "low",
      "reason": "Required to automate governance.",
      "members": [
        {

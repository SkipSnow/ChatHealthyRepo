{
  "$schema": "https://dev.chathealthy.ai/schemas/ChatHealthyPipelineConfigSchema.json",
  "fan_out": {
    "medicare": {
      "medicare_fetch_all_sources": {
        "partition_source": {
          "type": "config_list",
          "values": [
            {
              "source": "medicare_partb"
            },
            {
              "source": "medicare_partd"
            },
            {
              "source": "ccsr"
            },
            {
              "source": "icd10_cm"
            },
            {
              "source": "openfda_labels"
            },
            {
              "source": "medicare_pos"
            },
            {
              "source": "medicare_coverage_hcpc"
            },
            {
              "source": "medicare_coverage_icd10"
            },
            {
              "source": "rxnorm"
            }
          ]
        }
      },
      "medicare_load_staging": {
        "partition_source": {
          "type": "config_list",
          "values": [
            {
              "source": "medicare_partb"
            },
            {
              "source": "medicare_partd"
            },
            {
              "source": "ccsr"
            },
            {
              "source": "icd10_cm"
            },
            {
              "source": "openfda_labels"
            },
            {
              "source": "medicare_pos"
            },
            {
              "source": "medicare_coverage_hcpc"
            },
            {
              "source": "medicare_coverage_icd10"
            },
            {
              "source": "rxnorm"
            }
          ]
        }
      },
      "rollup_specialtymedicare": {
        "partition_source": {
          "type": "named_enumerator",
          "name": "molecule_slices",
          "params": {
            "workers": 300
          }
        },
        "parallelism_cap": 300
      },
      "build_fda_label_resolution": {
        "partition_source": {
          "type": "named_enumerator",
          "name": "record_ranges",
          "params": {
            "count": 400
          }
        },
        "parallelism_cap": 400
      },
      "build_providermedicare_base": {
        "partition_source": {
          "type": "named_enumerator",
          "name": "cms_states"
        },
        "parallelism_cap": 60
      },
      "enrich": {
        "partition_source": {
          "type": "named_enumerator",
          "name": "source_states"
        },
        "parallelism_cap": 60
      },
      "drop_transient_attributes_and_records": {
        "partition_source": {
          "type": "named_enumerator",
          "name": "source_states"
        },
        "parallelism_cap": 60
      }
    }
  },
  "pipeline_config": [
    {
      "env": "dev",
      "worker_vm_size": "Standard_E16as_v7",
      "worker_max_parallel": 400,
      "batch_limits": {
        "normalize_batch_size": 1000
      },
      "dataset_versions": [
        {
          "source_name": "nppes_npi",
          "bundled_with": "nppes_full_dissemination_zip",
          "fetch": {
            "source_url": {
              "page_url": "https://download.cms.gov/nppes/NPI_Files.html",
              "instructions": "Find the URL of the latest **full monthly** NPPES NPI Dissemination zip file. Rules: (a) Look for files whose name starts with `NPPES_Data_Dissemination_<Month>_<Year>` and ends with `.zip`. (b) The publisher sometimes appends a version stamp like `_V2`, `_V3`, etc. When multiple version stamps exist for the same month, return the HIGHEST version number for the LATEST month. (c) IGNORE filenames that contain `Weekly` (those are incremental diff files, not full files). (d) IGNORE filenames that contain `Deactivated` (those are deactivated-NPI reports, not provider data). (e) Return only the absolute URL of the chosen file."
            }
          },
          "archive_member": "npidata_pfile*.csv",
          "file_format": "csv",
          "staging_name": "PublicStaging.StagingProvider",
          "public_data_name": "PipelinePublicHealthData.NppesNpi"
        },
        {
          "source_name": "pl_pfile",
          "bundled_with": "nppes_full_dissemination_zip",
          "archive_member": "pl_pfile*.csv",
          "file_format": "csv",
          "staging_name": "PublicStaging.StagingPlPfile",
          "public_data_name": "PipelinePublicHealthData.PlPfile"
        },
        {
          "source_name": "nucc",
          "fetch": {
            "source_url": {
              "page_url": "https://www.nucc.org/index.php/code-sets-mainmenu-41/provider-taxonomy-mainmenu-40/csv-mainmenu-57",
              "instructions": "Find the URL of the latest NUCC Provider Taxonomy CSV file. Rules: (a) Look for the CSV file (filename ends with .csv) that contains the current taxonomy code set; the file usually has a name like `nucc_taxonomy_<version>.csv`. (b) If multiple versions are listed, return the URL of the most recent one. (c) IGNORE PDF, XLSX, and ZIP files -- only the CSV is the data file we want. (d) Return only the absolute URL."
            }
          },
          "file_format": "csv",
          "staging_name": "PublicStaging.StagingNucc",
          "public_data_name": "PipelinePublicHealthData.Nucc"
        },
        {
          "source_name": "census_zcta_county",
          "fetch": {
            "source_url": {
              "page_url": "https://www2.census.gov/geo/docs/maps-data/data/rel2020/zcta520/",
              "instructions": "Find the URL of the latest US Census ZCTA-to-County relationship file. Rules: (a) The file is a pipe-delimited TXT named like `tab20_zcta520_county20_natl.txt` -- national-scope ZCTA-to-county crosswalk. (b) Pick the national-scope file (`_natl`), NOT a state-level extract. (c) Return only the absolute URL."
            }
          },
          "file_format": "pipe_delimited",
          "staging_name": "PublicStaging.StagingCensusZctaCounty",
          "public_data_name": "PipelinePublicHealthData.CensusZctaCounty"
        },
        {
          "source_name": "usda_rucc",
          "fetch": {
            "source_url": {
              "page_url": "https://www.ers.usda.gov/data-products/rural-urban-continuum-codes/",
              "instructions": "Find the URL of the latest USDA Rural-Urban Continuum Codes (RUCC) spreadsheet file. Rules: (a) Look for the most recent year's RUCC file (filename typically `Ruralurbancontinuumcodes<YEAR>.xlsx` or similar). (b) MUST be an XLSX or CSV, not PDF. (c) Pick the file that contains the actual county-level RUCC codes 1-9, not documentation. (d) Return only the absolute URL."
            }
          },
          "file_format": "xlsx",
          "staging_name": "PublicStaging.StagingUsdaRucc",
          "public_data_name": "PipelinePublicHealthData.UsdaRucc"
        },
        {
          "source_name": "specialty_catalog",
          "fetch": {
            "source_url": "https://chathealthy.ai/Data/specialty_classification_gpt41.json"
          },
          "file_format": "json",
          "staging_name": "PublicStaging.StagingSpecialtyCatalog",
          "public_data_name": "PipelinePublicHealthData.SpecialtyCatalog"
        },
        {
          "source_name": "icd10_cm",
          "fetch": {
            "fetch_spec": {
              "mode": "static_page_latest",
              "page_url": "https://www.cms.gov/medicare/coding-billing/icd-10-codes",
              "link_suffix": "-code-descriptions-tabular-order.zip"
            }
          },
          "file_format": "zip_containing_icd10cm_order",
          "archive_member": "icd10cm_order_2026.txt",
          "staging_name": "PublicStaging.StagingIcd10Cm",
          "public_data_name": "PipelinePublicHealthData.Icd10Cm"
        },
        {
          "source_name": "provider",
          "public_data_name": "PipelinePublicHealthData.Provider",
          "depends_on": [
            "nppes_npi",
            "pl_pfile",
            "smd",
            "usda_rucc",
            "census_zcta_county"
          ]
        },
        {
          "source_name": "smd",
          "public_data_name": "PipelinePublicHealthData.SpecialtyMetaData",
          "depends_on": [
            "nucc",
            "specialty_catalog"
          ]
        },
        {
          "source_name": "other_identifier_phrases",
          "staging_name": "PublicStaging.OtherIdentifierPhrases",
          "public_data_name": "PipelinePublicHealthData.OtherIdentifierPhrases",
          "depends_on": [
            "provider"
          ]
        },
        {
          "source_name": "medicare_partb",
          "fetch": {
            "fetch_spec": {
              "mode": "dkan_catalog",
              "catalog_url": "https://data.cms.gov/data.json",
              "dataset_title": "Medicare Physician & Other Practitioners - by Provider and Service"
            }
          },
          "file_format": "csv",
          "staging_name": "PublicStaging.StagingMedicarePartB",
          "public_data_name": "PipelinePublicHealthData.MedicarePartB"
        },
        {
          "source_name": "medicare_partd",
          "fetch": {
            "fetch_spec": {
              "mode": "dkan_catalog",
              "catalog_url": "https://data.cms.gov/data.json",
              "dataset_title": "Medicare Part D Prescribers - by Provider and Drug"
            }
          },
          "file_format": "csv",
          "staging_name": "PublicStaging.StagingMedicarePartD",
          "public_data_name": "PipelinePublicHealthData.MedicarePartD"
        },
        {
          "source_name": "ccsr",
          "fetch": {
            "fetch_spec": {
              "mode": "static_page_latest",
              "page_url": "https://hcup-us.ahrq.gov/toolssoftware/ccsr/dxccsr.jsp",
              "link_suffix": ".zip"
            }
          },
          "file_format": "zip_containing_csv",
          "staging_name": "PublicStaging.StagingCcsr",
          "public_data_name": "PipelinePublicHealthData.Ccsr"
        },
        {
          "source_name": "openfda_labels",
          "fetch": {
            "fetch_spec": {
              "mode": "sharded_manifest",
              "manifest_url": "https://api.fda.gov/download.json",
              "list_path": [
                "results",
                "drug",
                "label",
                "partitions"
              ],
              "url_field": "file"
            }
          },
          "file_format": "zip_containing_json",
          "staging_name": "PublicStaging.StagingOpenFdaLabels",
          "public_data_name": "PipelinePublicHealthData.OpenFdaLabels"
        },
        {
          "source_name": "rxnorm",
          "fetch": {
            "fetch_spec": {
              "mode": "uts_release",
              "release_type": "rxnorm-full-monthly-release",
              "api_key_env": "UMLS_API_KEY"
            },
            "extract": {
              "mode": "zip",
              "member_path": [
                "rrf/RXNCONSO.RRF"
              ]
            }
          },
          "file_format": "rrf_rxnconso",
          "staging_name": "PublicStaging.StagingRxnormConso",
          "public_data_name": "PipelinePublicHealthData.RxnormConso"
        },
        {
          "source_name": "medicare_pos",
          "fetch": {
            "fetch_spec": {
              "mode": "dkan_catalog",
              "catalog_url": "https://data.cms.gov/data.json",
              "dataset_title": "Provider of Services File - Quality Improvement and Evaluation System"
            },
            "source_encoding": "latin-1"
          },
          "file_format": "csv",
          "staging_name": "PublicStaging.StagingMedicarePos",
          "public_data_name": "PipelinePublicHealthData.MedicarePos"
        },
        {
          "source_name": "medicare_coverage_hcpc",
          "fetch": {
            "fetch_spec": {
              "mode": "direct_url",
              "url": "https://downloads.cms.gov/medicare-coverage-database/downloads/exports/all_article.zip"
            },
            "extract": {
              "mode": "zip",
              "member_path": [
                "all_article_csv.zip",
                "article_x_hcpc_code.csv"
              ]
            }
          },
          "file_format": "csv",
          "staging_name": "PublicStaging.StagingMedicareCoverageHcpc",
          "public_data_name": "PipelinePublicHealthData.MedicareCoverageHcpc"
        },
        {
          "source_name": "medicare_coverage_icd10",
          "fetch": {
            "fetch_spec": {
              "mode": "direct_url",
              "url": "https://downloads.cms.gov/medicare-coverage-database/downloads/exports/all_article.zip"
            },
            "extract": {
              "mode": "zip",
              "member_path": [
                "all_article_csv.zip",
                "article_x_icd10_covered.csv"
              ]
            }
          },
          "file_format": "csv",
          "staging_name": "PublicStaging.StagingMedicareCoverageIcd10",
          "public_data_name": "PipelinePublicHealthData.MedicareCoverageIcd10"
        },
        {
          "source_name": "providermedicare",
          "public_data_name": "PipelinePublicHealthData.providerMedicarePartDQuantityRollUps",
          "depends_on": [
            "medicare_partb",
            "medicare_partd",
            "provider"
          ]
        },
        {
          "source_name": "specialtymedicare",
          "public_data_name": "PipelinePublicHealthData.specialtyMedicarePartDQuantityRollUps",
          "depends_on": [
            "providermedicare"
          ]
        },
        {
          "source_name": "fda_drug",
          "public_data_name": "PipelinePublicHealthData.fdaProductToDiagnosisResolution",
          "depends_on": [
            "icd10_cm",
            "openfda_labels"
          ]
        },
        {
          "source_name": "rxnorm_rel",
          "fetch": {
            "fetch_spec": {
              "mode": "uts_release",
              "release_type": "rxnorm-full-monthly-release",
              "api_key_env": "UMLS_API_KEY"
            },
            "extract": {
              "mode": "zip",
              "member_path": [
                "rrf/RXNREL.RRF"
              ]
            }
          },
          "file_format": "rrf_rxnrel",
          "staging_name": "PublicStaging.StagingRxnormRel",
          "public_data_name": "PipelinePublicHealthData.RxnormRel"
        }
      ],
      "failure_thresholds": {
        "discrepancy_abort": 1000
      },
      "source_freshness": [
        {
          "source_name": "nppes_npi",
          "number_of_days": 30
        },
        {
          "source_name": "census_zcta_county",
          "number_of_days": 365
        },
        {
          "source_name": "usda_rucc",
          "number_of_days": 365
        },
        {
          "source_name": "icd10_cm",
          "number_of_days": 90
        },
        {
          "source_name": "nucc",
          "number_of_days": 90
        },
        {
          "source_name": "specialty_catalog",
          "always_refetch": true
        }
      ],
      "discrepancy_report": {
        "report_cap_per_class": 25,
        "business_record_keys": {
          "provider": "npi",
          "specialty_metadata": "Code",
          "fda": "set_id"
        },
        "finding_types": {
          "schema_violation": {
            "severity": "fatal",
            "fatal_at_count": null,
            "max": null
          },
          "missing_npi": {
            "severity": "error",
            "fatal_at_count": null,
            "max": null
          },
          "missing_entity_type_code": {
            "severity": "fatal",
            "fatal_at_count": null,
            "max": null
          },
          "invalid_npi": {
            "severity": "fatal",
            "fatal_at_count": null,
            "max": null
          },
          "invalid_entity_type_code": {
            "severity": "fatal",
            "fatal_at_count": null,
            "max": null
          },
          "error_specialty_embedding_failed": {
            "severity": "fatal",
            "fatal_at_count": null,
            "max": null
          },
          "unresolved_taxonomy_code": {
            "severity": "fatal",
            "fatal_at_count": null,
            "max": null
          },
          "county_unresolvable": {
            "severity": "warning",
            "fatal_at_count": null,
            "max": null
          },
          "partd_brand_unmatched_to_fda": {
            "severity": "warning",
            "fatal_at_count": 15000000,
            "max": null
          },
          "state_missing_no_license": {
            "severity": "warning",
            "fatal_at_count": null,
            "max": null
          },
          "state_missing_ambiguous_license": {
            "severity": "warning",
            "fatal_at_count": null,
            "max": null
          },
          "coordinates_unresolvable": {
            "severity": "warning",
            "fatal_at_count": null,
            "max": null
          },
          "FDA_NPI_not_found_In_Providers": {
            "severity": "error",
            "fatal_at_count": 1200000,
            "max": null,
            "report_display_cap": 25
          },
          "FDA_all_other_Attribute_failures": {
            "severity": "error",
            "fatal_at_count": 1200000,
            "max": null,
            "report_display_cap": 25
          },
          "molecule_without_indication": {
            "severity": "error",
            "fatal_at_count": 5000,
            "max": null
          },
          "indication_without_icd10": {
            "severity": "error",
            "fatal_at_count": 5000,
            "max": null
          },
          "drug_without_rxnorm_molecule": {
            "severity": "error",
            "fatal_at_count": 5000,
            "max": null
          }
        }
      },
      "metadata": {
        "subscribers_secret": "notification-to-email"
      },
      "worker_liveness": {
        "silent_after_s": 440
      },
      "fda": {
        "crosswalk_batch_size": 25,
        "llm_retry": {
          "max_transient_retries": 5,
          "backoff_base_s": 2
        }
      },
      "worker_start_stagger_s": 5
    },
    {
      "env": "qa",
      "batch_limits": {
        "normalize_batch_size": 1000
      },
      "dataset_versions": [
        {
          "source_name": "nppes_npi",

@startuml
title Inside SharedServices: the facade, the navigator, and dispatch by subscription

skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam ArrowColor #0b7a75
skinparam ComponentBorderColor #0b7a75
skinparam DatabaseBorderColor #6b7280
skinparam NoteBackgroundColor #f3f4f6
skinparam NoteBorderColor #9ca3af

package "SharedServices process" #fdfdfd {

  [Gate\na facade — the one entrance] as GATE

  package "UniversalNavigator" #fbfdfd {
    [Reads the map;\nvalidates the selection;\ndrives the dispatch] as ROUTE
    [Render ledger\ndispatch owes a page;\ntimeout races the callback] as LEDGER
    [Merge — serial, deterministic\n(the library's function)] as MERGE
    [Session and\nsecurity helpers] as SEC
  }

  [UtteranceManager\npreamble + fragments ->\nthe set of tools to dispatch to] as UM

  package "Tools · ChatHealthyTool subclasses" #fbfdfd {
    [ProviderSearch] as T1
    [ProviderDetail] as T2
    [SpecialtyFilter] as T3
    [Selection · Facility\nTrials · ...] as T4
    [Prose\nauthors the\nuser-facing sentence] as TP
    [LockoutTool\nNOT_UTTERANCE_ROUTABLE] as TL
  }
}

database "ToolRegistry\none record per build per env:\ntools, subscriptions, may_call,\nfragments, routes and proofs" as REG #eef6f5
database "Sessions and ledger\n(front-end cluster)" as SESS

GATE -down-> ROUTE : token, head,\nparameters
ROUTE -[#9ca3af]up-> GATE : stream the\nanswer back
ROUTE -right-> UM : classify:\nwhat to dispatch to

REG <-- ROUTE : reads the live\nmap at startup
REG <-[#9ca3af]- UM : fragments assembled\ninto the preamble

ROUTE -down-> LEDGER : dispatch\nby subscription
LEDGER -right-> MERGE
MERGE -up-> ROUTE : merged document
SEC -down-> SESS : validate once;\nstate as rows

LEDGER -down-> T1
T1 -[#9ca3af]up-> LEDGER : completion callback\ncloses the entry
ROUTE .down.> TP : slot missing:\ndispatch prose\nwith the facts

T1 -[hidden]right- T2
T2 -[hidden]right- T3
T3 -[hidden]right- T4
T4 -[hidden]right- TP
TP -[hidden]right- TL

note left of GATE
  Knows transport exists; nothing else does.
  Collects the request's facts and passes
  them on; streams what comes back.
  Verifies nothing itself — the navigator's
  helpers own security.
end note

note bottom of TL
  A tool declares exactly one of a routing
  fragment or NOT_UTTERANCE_ROUTABLE.
  Silence refuses the build, so a safety
  tool's unreachability is a decision, never
  an omission.
end note

note right of MERGE
  A conflict between two returning
  documents is an exception,
  never last-writer-wins.
end note
@enduml

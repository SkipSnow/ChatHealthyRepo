@startuml
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam ArrowColor #0b7a75
skinparam ComponentBorderColor #0b7a75
skinparam DatabaseBorderColor #6b7280
skinparam NoteBackgroundColor #f3f4f6
skinparam NoteBorderColor #9ca3af

title ChatHealthy.ai — Local Security Architecture\nProof-per-route front application in Docker — 2026-09-14

' ── the five incoming call types originate outside the host ──
actor "Consumer\n(Browser)" as user
actor "Third party\n(OAuth callback)" as third
actor "Our static\npages (onload)" as static

package "Skip's PC — Docker (localhost)" as host <<physical>> #eef6f5 {

  package "SharedServices container :8002" as c_ss #fdfdfd {
    component [Gate — transport facade\nTLS term • collect token + head + params\nproof: route known? verify or refuse\nthe only node knowing transport exists] as gate_ss
    component [UniversalNavigator (the main)\nthe only node accepting external traffic\nsessions • timeouts • render ledger\nserial deterministic merge\ninstruments every failure] as nav
    component [UtteranceManager\npreamble + registry fragments\n→ dispatch set (parallel)] as um
    component [ProseTool\nfacts → user sentence] as prose
    component [Shared tools\nSafety • Consent • Lead\nUnknownQ • About • URLGuardian] as shared
    component [SecretManager\nx509 → Key Vault • in-memory only] as secrets
    component [ChatHealthyMongoUtilities] as mongo_util
  }

  package "FindCare container :8000" as c_fc #fdfdfd {
    component [Gate\nour_signature internal traffic only\n(never a client session)] as gate_fc
    component [UniversalNavigatorProxy\ntool-to-tool relay • metadata slice\nrefuses stale metadata] as proxy_fc
    component [FindCare tools\nProviderSearch • Specialty] as fc_tools
  }

  package "EvaluateCare container :8001" as c_ec #fdfdfd {
    component [Gate\nour_signature internal traffic only] as gate_ec
    component [UniversalNavigatorProxy\ntool-to-tool relay\nrefuses stale metadata] as proxy_ec
    component [EvaluateCare tools\nScoring • UserContext • ScreenPainter] as ec_tools
  }
}

database "Front-end Mongo\nToolRegistry — one live doc / env\nSessions • RenderLedger rows" as mongo
component [Azure Key Vault\nFedRAMP High • HIPAA BAA • public access off\n----\nsession signing key\ninternal-callback signing key\nOAuth api_key secrets\nMongo conn strings\nmodel API keys • x509 certs] as kv #f3f4f6
actor "Deploying\nidentity" as deployer

' ── incoming external calls: each proven at the gate ──
user   --> gate_ss : client_sessioned\nsession_token (per-hop nonce)
third  --> gate_ss : third_party_callback\napi_key (kept in vault)
static ..> gate_ss : static_witness\nproof none — log only

gate_ss --> nav : token + head + params

' ── the main reads the map and drives the route ──
nav --> um : utterance → routes
nav --> prose : facts
nav --> shared : dispatch (tool_to_tool)

' ── cross the wire to a satellite: signed out, signed back ──
nav --> gate_fc : dispatch signed out\ninternal_callback (our_signature)
gate_fc --> proxy_fc
proxy_fc --> fc_tools
fc_tools ..> nav : completion (our_signature)

nav --> gate_ec : dispatch signed out\ninternal_callback (our_signature)
gate_ec --> proxy_ec
proxy_ec --> ec_tools
ec_tools ..> nav : completion (our_signature)

' ── state, secrets, and registry write governance ──
nav --> mongo : sessions • render ledger\nreads live registry at startup
mongo_util --> secrets : conn strings (in-memory)
secrets   -[#6b7280]-> kv : x509 cert auth\nprivate key never on disk/git
deployer  -[#6b7280]-> mongo : registry sole writer\n(runtime identities read-only)

note right of kv
  **Local security posture**
  - Proof-per-route: session_token, api_key,
    our_signature, or none — verified or refused.
  - All secrets fetched from Key Vault via x509;
    zero .env credentials, no key in git.
  - Registry: one live doc per env, deploying
    identity the only writer, full history kept.
  - Transport security (mTLS between containers)
    couples at the infrastructure migration —
    separate and later than this refactor.
end note

@enduml

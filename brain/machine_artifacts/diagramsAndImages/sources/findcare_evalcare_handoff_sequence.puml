@startuml FindCare_EvaluateCare_Handoff
!theme plain
title FindCare → EvaluateCare Handoff Sequence\nProvider Evaluation Flow\n2026-04-06

skinparam backgroundColor white
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 250

actor "Consumer\n(Browser)" as user
participant "React App\n(:5173)" as react
participant "Secure Cookie\n(encrypted)" as cookie
participant "FindCare\n(:8000)" as fc
participant "EvaluateCare\n(:8001)" as ec
database "MongoDB\nFrontend\nCluster" as db
participant "Anthropic\nClaude" as llm
participant "Parent Frame\n(Website)" as parent

== Phase 1: User Searches for Providers ==

user -> react : "Find me a cardiologist\nin Virginia"
react -> fc : POST /chat\n{message, history[], ip}

fc -> fc : SafetyService.check()\n(dual-trigger: keyword + classifier)

fc -> llm : Chat completion\nwith tool definitions
llm -> fc : tool_call: find_providers\n{specialty: "cardiology",\n state: "VA"}

fc -> db : Vector search\nProviders collection\n(text-embedding-3-small)
db -> fc : Provider results\n[{npi, name, address,\n specialty, county}...]

fc -> fc : URLGuardian.guard_tool_result()
fc -> llm : Tool result:\n25 providers found
llm -> fc : "Here are 25 cardiologists\nin Virginia..."

fc -> react : Response:\n{message, providers[],\n total_count: 347}

react -> cookie : Read visit cookie
note right of cookie
  **Encrypted secure cookie**
  {
    ip_hash: "a3f8...",
    visits: [
      {date: "2026-04-01", queries: 3},
      {date: "2026-04-04", queries: 7},
      {date: "2026-04-06", queries: 1}
    ]
  }
  - HttpOnly, Secure, SameSite=Strict
  - AES-256 encrypted
  - Auto-deleted if oldest visit > 90 days
end note

cookie -> react : visit_count: 3,\ncurrent_queries: 1

react -> cookie : Update: current_queries++
react -> user : Display provider list\nin chat window

== Phase 2: Offer Evaluation ==

react -> user : "Would you like to evaluate\nthese providers against\nwhat we know about them?"

user -> react : "Yes"

== Phase 3: Build Handoff Payload ==

react -> react : Build handoff request

alt Paid User (authenticated via OAuth)
  react -> react : Include user_db_ref:\n{cluster: "frontend",\n db: "prod_UserAccounts",\n user_id: "usr_8a3f..."}
  note right
    **GOV-011**: System answers
    using real data.
    User DB ref is a pointer —
    EvaluateCare reads the record.
    Only for paying users.
  end note
else Anonymous User (no account)
  react -> react : user_db_ref: null
  note right
    Anonymous users get evaluation
    based on cookie + chat context only.
    No DB record to reference.
  end note
end

react -> fc : POST /evaluate-handoff\n{chat_history: [...full history...],\n providers: [{npi, name, ...}...],\n user_db_ref: "usr_8a3f..." | null,\n cookie_stats: {\n   visit_count: 3,\n   visits: [{date, queries}...]\n },\n question_context: "cardiologist in VA"}

== Phase 4: FindCare → EvaluateCare (mTLS) ==

fc -> fc : Validate payload\n(Pydantic model)
fc -> fc : Verify cookie_stats\nintegrity (decrypt + validate)

fc -[#red]> ec : POST /evaluate/providers\n<<mTLS authenticated>>\n{\n  chat_history: [...],\n  providers: [{npi}...],\n  user_db_ref: "usr_8a3f..." | null,\n  cookie_stats: {visit_count, visits[]},\n  question_summary: "User seeking\n    cardiologist in VA"\n}

== Phase 5: EvaluateCare Processes ==

ec -> ec : UserContextResolver:\nBuild user profile

alt user_db_ref is not null (paid user)
  ec -> db : Read user record\nfrom UserAccounts\n{user_id: "usr_8a3f..."}
  db -> ec : User profile:\n{insurance, location,\n preferences, history}
  note right of db
    **Only paid users** have
    persisted profiles.
    GOV-001: No care-chain
    data in user record.
  end note
end

ec -> ec : Parse cookie_stats:\n- 3 visits over 5 days\n- 11 total queries\n- Returning user pattern

ec -> ec : Synthesize user context:\n{is_paid, insurance_known,\n visit_frequency, query_pattern,\n question_intent}

loop For each provider in list
  ec -> db : Read quality signals\nfor NPI from\nProviders collection
  db -> ec : {board_certs, licenses,\n disciplinary_actions,\n cms_quality_scores,\n prescription_patterns}

  ec -> ec : ScoringEngine.score_provider()\n- Relevance to user condition\n- Quality signals\n- Credentialing\n- Geographic accessibility
end

ec -> ec : Rank providers\nby composite score

ec -> ec : ScreenPainter:\nFormat evaluation view

note right of ec
  **Evaluation Screen Contents:**
  1. Ranked provider list with scores
  2. Question summary:
     "Why evaluate: User is seeking
      a cardiologist in Virginia.
      3rd visit, 11 queries — engaged
      user exploring options."
  3. Known facts (from DB + cookie):
     - Insurance: Aetna PPO (if paid)
     - Location: Richmond, VA (if paid)
     - Visit pattern: 3 visits, 11 queries
     - Prior searches: pediatrician,
       dermatologist (from cookie)
end note

== Phase 6: Paint the Screen ==

ec -[#blue]> react : Response:\n{type: "eval-render",\n  ranked_providers: [...],\n  question_summary: "...",\n  user_facts: {...},\n  confidence_scores: [...]}

react -> parent : postMessage\n{type: "gui:eval-render",\n html: "<evaluation panel>"}

parent -> parent : Render evaluation\nin control frame +\nexpand right panel

react -> user : Evaluation displayed:\n- Ranked provider cards\n  with quality scores\n- "Why this evaluation"\n  summary panel\n- User context sidebar\n  (visit history, known facts)

note over user, parent
  **GOV-011 compliance**: AI translated user intent ("find me a cardiologist").
  System answered with real data (provider records, quality scores, visit stats).
  AI did not generate quality assessments — ScoringEngine did.
  All facts traceable to data layer (MongoDB, cookie).
end note

@enduml

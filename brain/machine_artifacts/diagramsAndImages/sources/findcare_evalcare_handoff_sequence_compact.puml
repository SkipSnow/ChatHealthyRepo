@startuml
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam ArrowColor #0b7a75
skinparam ComponentBorderColor #0b7a75
skinparam DatabaseBorderColor #6b7280
skinparam NoteBackgroundColor #f3f4f6
skinparam NoteBorderColor #9ca3af

skinparam backgroundColor white
skinparam maxMessageSize 210
skinparam sequence {
  ParticipantBorderColor #0b7a75
  ParticipantBackgroundColor #fdfdfd
  ActorBorderColor #0b7a75
  ActorBackgroundColor #fdfdfd
  LifeLineBorderColor #9ca3af
  DividerBackgroundColor #eef6f5
  DividerBorderColor #0b7a75
  GroupBackgroundColor #eef6f5
  GroupBorderColor #0b7a75
}

title FindCare provider search + EvaluateCare handoff\nTarget front-application architecture · 2026-09-14

actor "Consumer" as user

participant "React\nclient" as react

box "SharedServices  (main)" #eef6f5
participant "Gate\n(facade)" as gate
participant "Universal\nNavigator" as nav
participant "Utterance\nManager" as um
participant "Prose\ntool" as prose
end box

box "FindCare  (satellite)" #f3f4f6
participant "Nav\nProxy" as fcpx
participant "provider_\nsearch" as ps
end box

box "EvaluateCare  (satellite)" #f3f4f6
participant "Nav\nProxy" as ecpx
participant "evaluate_\nproviders" as ev
end box

database "MongoDB\nFrontend" as db
participant "Model\n(pydantic-ai)" as llm

== 1. Utterance arrives ==

user -> react : "Find cardiologist in VA"
react -> gate : POST + session token\n(call_type client_sessioned)
gate -> nav : session + head + params\n(nothing else)
note right of gate
  Transport-only proxy.
  Collects token/head/params,
  streams the one answer back.
end note

== 2. Classify (routes, not commands) ==

nav -> um : dispatch(utterance)
um -> llm : preamble + fragments\n(one model call)
llm -> um : routes
um -> nav : dispatch set {provider_search}
note right of um
  Non-blocking; parallel set.
  Knows no parameters.
  The registry assembles the prompt.
end note

== 3. Search — tool-to-tool via proxy ==

nav -> nav : completeness test vs contract;\nrecord render-ledger expectation
nav -> fcpx : dispatch provider_search
fcpx -> ps : local call
ps -> db : vector search Providers
db -> ps : 25 providers (347 total)
ps -> fcpx : result
fcpx -[#0b7a75]> nav : internal_callback (our_signature)\ncloses ledger entry

== 4. Prose is a separate tool ==

nav -> prose : dispatch(facts)
prose -> llm : author sentence
llm -> prose : "Here are 25 cardiologists..."
prose -[#0b7a75]> nav : internal_callback\ncloses ledger entry
nav -> nav : serial deterministic merge
nav -> gate : merged document
gate -> react : one stream
react -> user : Providers + "Evaluate these?"

== 5. Consumer accepts — second turn ==

user -> react : "Yes"
react -> gate : POST + session token
gate -> nav : session + head + params
nav -> um : dispatch(utterance)
um -> nav : dispatch set {evaluate_providers}
nav -> nav : merge params + session state\n(a conflict raises)
note right of nav
  Session, ledger, merge live only
  here. Every throw ends in a
  navigator; middle tools re-raise.
end note

== 6. Evaluate — tool-to-tool via proxy ==

nav -> ecpx : dispatch evaluate_providers
ecpx -> ev : local call
ev -> db : read user + quality signals per NPI
db -> ev : facts (certs, scores, actions)
ev -> ev : score + rank\n(ScoringEngine)
ev -[#0b7a75]> nav : internal_callback (our_signature)\ncloses ledger entry

== 7. Render — prose + the one stream ==

nav -> prose : dispatch(ranked facts)
prose -> llm : author summary
llm -> prose : user-facing sentence
prose -[#0b7a75]> nav : internal_callback
nav -> nav : serial merge
nav -> gate : merged document
gate -> react : one stream\n(the main's gate writes it)
react -> user : Ranked cards + summary + context

note over user, llm
  The UtteranceManager translated intent into routes; tools answered
  with real data, every fact from the data layer. The UniversalNavigator
  merged serially and its gate wrote the single stream.
end note

@enduml

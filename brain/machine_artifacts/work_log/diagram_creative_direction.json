        {
          "type": "arrow_group",
          "id": "input_flow",
          "arrows": [
            { "from": [250, 250], "to": [350, 250], "color": "gray" },
            { "from": [250, 350], "to": [350, 350], "color": "gray" },
            { "from": [250, 450], "to": [350, 450], "color": "gray" }
          ]

{
  "diagrams": [
    {
      "title": "FIND CARE",
      "canvas": { "width": 1000, "height": 700 },
      "elements": [
        {
          "type": "rectangle",
          "id": "gpu_chip",
          "x": 400,
          "y": 250,
          "width": 200,
          "height": 200,
          "color": "darkblue",
          "label": "GPU AI CORE"
        },
        {
          "type": "line_group",
          "id": "radiating_lines",
          "center_x": 500,
          "center_y": 350,
          "count": 12,
          "radius": 250,
          "color": "gray"
        },
        {
          "type": "text_cluster",
          "id": "questions",
          "region": "outer_left",
          "items": [
            { "text": "what is this pain", "x": 100, "y": 100, "color": "red" },
            { "text": "which doctor", "x": 120, "y": 250, "color": "red" },
            { "text": "is this serious", "x": 80, "y": 400, "color": "red" }
          ]
        },
        {
          "type": "text_cluster",
          "id": "answers",
          "region": "outer_right",
          "items": [
            { "text": "likely diagnosis", "x": 800, "y": 120, "color": "green" },
            { "text": "recommended specialist", "x": 780, "y": 300, "color": "green" },
            { "text": "next steps", "x": 820, "y": 480, "color": "green" }
          ]
        },
        {
          "type": "arrow_group",
          "id": "flow",
          "arrows": [
            { "from": [150, 120], "to": [400, 300], "color": "lightgray" },
            { "from": [150, 270], "to": [400, 350], "color": "lightgray" },
            { "from": [150, 420], "to": [400, 400], "color": "lightgray" },
            { "from": [600, 300], "to": [800, 150], "color": "lightgray" },
            { "from": [600, 350], "to": [780, 320], "color": "lightgray" },
            { "from": [600, 400], "to": [820, 500], "color": "lightgray" }
          ]
        }
      ]
    },
    {
      "title": "EVALUATE CARE",
      "canvas": { "width": 1100, "height": 700 },
      "elements": [
        {
          "type": "text_block",

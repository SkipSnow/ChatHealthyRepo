          "x": 50,
          "y": 200,
          "width": 200,
          "height": 300,
          "color": "blue",
          "label": "DATA SOURCES\nprescriptions\nprovider db\nquality scores"
        },
        {
          "type": "rectangle",
          "id": "mixing_board",
          "x": 350,
          "y": 150,
          "width": 300,
          "height": 400,
          "color": "darkgray",
          "label": "MIXING BOARD"
        },
        {
          "type": "slider_group",
          "id": "sliders",
          "sliders": [
            { "x": 400, "y": 200, "height": 200, "value": 0.7, "color": "orange" },
            { "x": 470, "y": 200, "height": 200, "value": 0.4, "color": "orange" },
            { "x": 540, "y": 200, "height": 200, "value": 0.8, "color": "orange" }
          ]

@startuml Security_Architecture_Local
!theme plain
title ChatHealthy.ai — Local Security Architecture\n2026-04-06

skinparam componentStyle rectangle
skinparam backgroundColor white
skinparam component {
  BackgroundColor #F5F5F5
  BorderColor #333333
  FontSize 10
}
skinparam package {
  FontSize 12
  BorderThickness 2
}

actor "Consumer\n(Browser)" as user

package "Skip's PC (localhost)" as env_local <<physical>> #EEEEFF {

  component [Caddy\nTLS termination\nmTLS enforcement\nRoute dispatch\nBasic auth (admin)] as caddy

  package "Frontend Services" as local_fe {
    component [Public Website :80] as website
    component [Admin Website :443\nAuth-gated] as admin
    component [React App :5173] as react
    component [Secure Cookie Mgr\nAES-256 encrypted\n90-day TTL] as cookie
  }

  package "FindCare :8000" as local_fc {
    component [FindCareFacade\nChatOrchestrator\nToolRouter\nProviderSearch\nSpecialty] as fc
    component [EvalCare Gateway] as fc_gw
  }

  package "EvaluateCare :8001" as local_ec {
    component [EvaluateCareFacade\nScoringEngine\nUserContextResolver\nScreenPainter] as ec
  }

  package "Shared Services :8002" as local_ss {
    component [SharedServicesFacade] as ss
    component [SecretManager\nx509 cert → Key Vault\nIn-memory only\nNever writes to disk] as secrets
    component [ChatHealthyMongoUtilities\nConn strings from SecretManager] as mongo_util
    component [SafetyService\nConsentService\nLeadService\nUnknownQuestionService\nAboutService\nURLGuardian] as shared_svcs
  }

  package "The Brain (App 4)" as local_brain {
    component [Claude Code CLI] as claude
    component [brain/ JSON\n22 collections] as brain
  }
}

package "Azure — ChatHealthySecurity" as env_sec <<physical>> #FFE8E8 {
  component [Azure Key Vault\nFedRAMP High\nHIPAA BAA\nFIPS 140-2 L2\nPublic access disabled\n---\nAll secrets:\nMongo conn strings\nAPI keys (Anthropic,\nOpenAI, SparkPost)\nmTLS certs\nOAuth secrets] as kv
}

' ── Security flows ──

user --> caddy : "TLS"
caddy --> website : "HTTP"
caddy --> admin : "Basic auth"
caddy --> react : "TLS"
caddy -[#red]-> fc : "<<mTLS>>"
caddy -[#red]-> ec : "<<mTLS>>"
caddy -[#red]-> ss : "<<mTLS>>"

fc -[#red]-> ss : "<<mTLS>>\nSecrets + shared services"
ec -[#red]-> ss : "<<mTLS>>\nSecrets + shared services"
fc_gw -[#red]-> ec : "<<mTLS>>\nHandoff"

secrets -[#red,bold]-> kv : "<<x509 cert>>\nAzure AD cert auth\nPrivate key on local disk\nNever in git (.gitignore)"

mongo_util --> secrets : "Conn strings\nin-memory"

claude --> brain

note bottom of env_local
  **Local security posture:**
  - All inter-service traffic: mTLS (no plaintext)
  - All secrets: fetched from Key Vault via x509
  - Zero .env files with credentials
  - Private key in .gitignore, never committed
  - Caddy enforces mTLS — direct port access rejected
  - Cookie: AES-256 encrypted, 90-day auto-delete
  - Admin site: auth-gated (Perplexity F-13 fix)
end note

@enduml

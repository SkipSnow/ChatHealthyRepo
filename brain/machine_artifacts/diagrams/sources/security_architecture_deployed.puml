@startuml Security_Architecture_Deployed
!theme plain
title ChatHealthy.ai — Deployed Security Architecture\ndev / qa / prod\n2026-04-06

skinparam componentStyle rectangle
skinparam backgroundColor white
skinparam component {
  BackgroundColor #F5F5F5
  BorderColor #333333
  FontSize 10
}
skinparam package {
  FontSize 12
  BorderThickness 2
}

actor "Consumer\n(Browser)" as user

package "Cloudflare" as env_cf <<physical>> #F5FFF5 {
  component [Pages — Public\nchathealthy.ai\nFree TLS\nDDoS protection\nBot Fight Mode] as cf_pub
  component [Pages — Admin\nadmin.chathealthy.ai\nCloudflare Access\nAuthenticated] as cf_admin
  component [DNS + SSL\nHSTS enforced\nTLS 1.2 minimum] as cf_dns
}

package "HuggingFace" as env_hf <<physical>> #F0FFF0 {
  package "FindCare Spaces" as hf_fc {
    component [dev / qa / prod\nport 7860\nDocker] as hf_fc_svc
  }
  package "EvaluateCare Spaces" as hf_ec {
    component [dev / qa / prod\nport 7860\nDocker] as hf_ec_svc
  }
  package "Shared Services Spaces" as hf_ss {
    component [dev / qa / prod\nport 7860\nDocker\nSecretManager\nMongoUtilities\nSafety, Consent, Lead] as hf_ss_svc
  }
}

package "Azure — ChatHealthySecurity" as env_sec <<physical>> #FFE8E8 {
  component [Azure Key Vault\nFedRAMP High\nHIPAA BAA eligible\nFIPS 140-2 Level 2\nSoft-delete + purge protection\nPublic access disabled\n---\nAuth: x509 (HF Spaces)\nManaged Identity (Azure)\nNo bearer tokens] as kv

  package "Azure VNet" as vnet {
    component [Azure Firewall\nDeny-all default\nAllow: Mongo, Anthropic,\nOpenAI, HF, SparkPost\nAudit logging] as fw
    component [Subnet: DataPipelines\nNSG restricted] as sub_pipe
    component [Subnet: BIZOperations\nNSG restricted] as sub_biz
    component [Subnet: Private Endpoints] as sub_pe
    component [Private Endpoint\n→ Key Vault] as pe_kv
    component [Private Endpoint\n→ MongoDB Atlas\n(frontend + pipeline)] as pe_mongo
  }
}

package "Azure — ChatHealthyDataPipelines" as env_pipe <<physical>> #FFF0F0 {
  component [Function App\nDurable Functions\nVNet integrated\nManaged Identity] as az_func
  component [Blob Storage\nSource data] as az_blob
}

package "Azure — ChatHealthyBIZOperations" as env_biz <<physical>> #FFF0F5 {
  component [BizOps Function App\nVNet integrated\nManaged Identity] as az_biz
}

package "MongoDB Atlas" as env_mongo <<physical>> #FFF8E8 {
  database [Frontend Cluster\n24/7\nIP allowlist:\nVNet PE + Skip's IP\nTLS required] as mongo_fe
  database [Pipeline Cluster\nOn-demand\nIP allowlist:\nVNet PE + Skip's IP\nZERO admin state] as mongo_pipe
}

package "Anthropic" as env_anth <<physical>> #F8F0FF {
  component [Claude Sonnet API\nAPI key from Key Vault] as api_claude
}

package "OpenAI" as env_oai <<physical>> #FFF8F0 {
  component [Embeddings\n+ Safety classifier\nAPI key from Key Vault] as api_oai
}

' ── Consumer flow ──

user --> cf_dns : "HTTPS"
cf_dns --> cf_pub
cf_dns --> cf_admin : "Cloudflare Access\n(authenticated)"
cf_pub --> hf_fc_svc : "iframe"

' ── HF inter-service (mTLS) ──

hf_fc_svc -[#red]-> hf_ec_svc : "<<mTLS>>"
hf_fc_svc -[#red]-> hf_ss_svc : "<<mTLS>>"
hf_ec_svc -[#red]-> hf_ss_svc : "<<mTLS>>"

' ── HF → Key Vault (x509) ──

hf_fc_svc -[#red,bold]-> kv : "<<x509 cert>>"
hf_ec_svc -[#red,bold]-> kv : "<<x509 cert>>"
hf_ss_svc -[#red,bold]-> kv : "<<x509 cert>>"

' ── HF → MongoDB (via Key Vault conn strings) ──

hf_ss_svc -[#orange]-> mongo_fe : "TLS\nIP allowlisted"

' ── HF → AI APIs (via Key Vault API keys) ──

hf_fc_svc -[#purple]-> api_claude : "API key\nfrom Key Vault"
hf_fc_svc -[#purple]-> api_oai : "API key\nfrom Key Vault"

' ── Azure Functions → VNet ──

az_func --> sub_pipe : "VNet integrated"
az_biz --> sub_biz : "VNet integrated"
sub_pipe --> fw : "Outbound"
sub_biz --> fw : "Outbound"

' ── Azure → Key Vault (Managed Identity) ──

az_func -[#darkgreen,bold]-> pe_kv : "<<Managed Identity>>\nZero credentials"
az_biz -[#darkgreen,bold]-> pe_kv : "<<Managed Identity>>"
pe_kv --> kv

' ── Azure → MongoDB (Private Endpoint) ──

sub_pipe --> pe_mongo
pe_mongo -[#orange]-> mongo_fe : "Private link"
pe_mongo -[#orange]-> mongo_pipe : "Private link"

' ── Azure → Blob ──

az_func --> az_blob

' ── Pipeline promotion ──

mongo_pipe .[#gray,dashed].> mongo_fe : "CopyToFrontEnd"

note bottom of env_sec
  **Deployed security posture:**
  - Zero bearer tokens — all auth via x509 or Managed Identity
  - Azure Firewall: deny-all default, explicit allowlist
  - Private endpoints: Key Vault + MongoDB never on public internet
  - NSG per subnet: only required ports/protocols
  - MongoDB IP allowlist: VNet PE + Skip's IP only
  - All inter-service: mTLS (certs from Key Vault)
  - FedRAMP High, HIPAA BAA, FIPS 140-2 L2, HITRUST
  - NIST 800-171 compliant (CUI protection ready)
  - TRICARE-ready: CUI-level protection for military beneficiaries
end note

@enduml

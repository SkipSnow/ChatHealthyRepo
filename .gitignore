# Ignore environment variable files
.env
code/.env
Code/.env
**/.env

# Ignore temporary / editor backup files
~*
*.tmp

# Notebooks belong in ChatHealthyLabRepo, not here
*.ipynb

# Virtual environments
.venv/
venv/
venv_func/
__pycache__/
*.pyc

# Claude Code — track settings files, ignore transient data
.claude/backups/
.claude/file-history/
.claude/ide/
.claude/ChatHealthySettings.json
.claude/ChatHealthySettings.json.bak
.claude/plans/
.claude/sessions/
.claude/session-env/
.claude/shell-snapshots/
.claude/.credentials.json
.claude/mcp-needs-auth-cache.json

# DataPipelines HTTP test file — contains bearer token and instance URLs
Code/DataPipelines/api-tests.http
Code/*.http
*.http

# DataPipelines local-only files
Code/DataPipelines/pipeline_files.json
Code/DataPipelines/pipeline_code_review.json

# Explicitly allow .evv directory and contents
!.evv/
!.evv/**

# Build artifacts
node_modules/
dist/
Code/ConversationalUX/FindCareChat/backend/static/
.env.local

# .NET build output
**/bin/
**/obj/
**/out/

# Runtime logs
*.log

# Business artifacts — confidential, local only
# brain/BusinessArtifacts/ — tracked, contains audit reports

# Local SSL certs — never commit
Code/Shared/ops/certs/


# Test screenshots — generated by Playwright, not source
/test_*.png
/umls_signup.png
Code/ConversationalUX/FindCareChat/backend/tests/test_screenshots/
test_output/

# Caddy binary — downloaded, not source
Code/Shared/ops/tools/caddy.exe

# Analysis videos — large, not source
Analysis/*.mp4

# Conversation log — local dev artifact, contains secrets from session
brain/machine_artifacts/content/conversation_log.json
regression_report.json
migrate_dev_to_qa.py
# C# build artifacts
Code/CSharp/**/bin/
Code/CSharp/**/obj/
Code/CSharp/**/build/

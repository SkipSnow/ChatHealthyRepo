# Ignore environment variable files
.env
code/.env
Code/.env
**/.env

# Local proprietary source data — not source code; per Skip 2026-05-28
SourcePropriataryData/

# Ignore temporary / editor backup files
~*
*.tmp
*.bak

# Notebooks belong in ChatHealthyLabRepo, not here
*.ipynb

# Virtual environments
.venv/
venv/
venv_func/
__pycache__/
*.pyc
*.egg-info/

# Claude Code — track settings files, ignore transient data
.claude/backups/
.claude/file-history/
.claude/ide/
.claude/ChatHealthySettings.json
.claude/ChatHealthySettings.json.bak
.claude/plans/
.claude/sessions/
.claude/session-env/
.claude/shell-snapshots/
.claude/.credentials.json
.claude/mcp-needs-auth-cache.json
.claude/scheduled_tasks.lock

# Derived deploy artifacts (canonicals live in
# architecture/DevOpsBuildDeployAndEnvironmentManagement/).
Code/ConversationalUX/FindCareChat/frontend/vite.config.ts

# DataPipelines HTTP test file — contains bearer token and instance URLs
*.http

# DataPipelines local-only files
Code/DataPipelines/pipeline_files.json
Code/DataPipelines/pipeline_code_review.json

# Explicitly allow .evv directory and contents
!.evv/
!.evv/**

# Build artifacts
node_modules/
dist/
Code/ConversationalUX/FindCareChat/backend/static/
.env.local

# .NET build output
**/bin/
**/obj/
**/out/

# Runtime logs
*.log

# Business artifacts — confidential, local only (Skip directive 2026-04-20)
brain/BusinessArtifacts/

# Local SSL certs — never commit
Code/Shared/ops/certs/


# Test screenshots — generated by Playwright, not source
/test_*.png
/umls_signup.png
_oneshots/test_output/

# Caddy binary — downloaded, not source
Code/Shared/ops/tools/caddy.exe

# Analysis videos — large, not source
Analysis/*.mp4

# C# build artifacts — generic catch under the per-feature layout
**/build/
architecture/Conversation-logPipeline/bin/
architecture/Conversation-logPipeline/obj/
architecture/Conversation-logPipeline/out/
architecture/Conversation-logPipeline/build/
brain/machine_artifacts/.iteration_cache/

# Markdown files: dev-only artifacts (Claude scratchpads, audit reports, etc.)
# never served to users; not subject to BR-13 HTTP scan.
*.md

# Archive directories: any "archive" subdir is gitignored at any depth.
# Currently-tracked content under archive/ stays tracked (Skip directive 2026-04-30:
# add the pattern, do NOT clean up the repo). Future additions are ignored.
archive/

# One-shot scratch scripts and dumps. Claude writes any one-shot helper
# (audit script, JSON dump, doc-injector, etc.) into a _oneshots/ dir so
# it never gets caught by pre-commit or accidentally committed.
_oneshots/
**/_oneshots/

# Cloudflare wrangler CLI local cache — account_id + project_name
# scratchpad created automatically when wrangler pushes to Pages.
# Local-only state; not source code.
.wrangler/

# Workstation build outputs. One current build at a time; git is not the
# archive for these. The remoteBuild/ tree IS tracked (per-branch HEAD
# carries the artifact promoted via merge), so it is NOT listed here.
architecture/DevOpsBuildDeployAndEnvironmentManagement/localBuild/
.claude/worktrees/

# Rule-065 commit-authorization audit log: machine-local audit trail of every
# approve/reject/timeout/interrupt verdict. Durable, never committed.
architecture/EngineeringRuleEnforcement/ArchitectureDesignAndAuditDocs/commit_authorization.log

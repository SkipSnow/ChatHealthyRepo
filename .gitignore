# Ignore environment variable files
.env
code/.env
Code/.env
**/.env

# Ignore temporary / editor backup files
~*
*.tmp
*.bak

# Notebooks belong in ChatHealthyLabRepo, not here
*.ipynb

# Virtual environments
.venv/
venv/
venv_func/
__pycache__/
*.pyc

# Claude Code — track settings files, ignore transient data
.claude/backups/
.claude/file-history/
.claude/ide/
.claude/ChatHealthySettings.json
.claude/ChatHealthySettings.json.bak
.claude/plans/
.claude/sessions/
.claude/session-env/
.claude/shell-snapshots/
.claude/.credentials.json
.claude/mcp-needs-auth-cache.json

# DataPipelines HTTP test file — contains bearer token and instance URLs
Code/DataPipelines/api-tests.http
Code/*.http
*.http

# DataPipelines local-only files
Code/DataPipelines/pipeline_files.json
Code/DataPipelines/pipeline_code_review.json

# Explicitly allow .evv directory and contents
!.evv/
!.evv/**

# Build artifacts
node_modules/
dist/
Code/ConversationalUX/FindCareChat/backend/static/
.env.local

# .NET build output
**/bin/
**/obj/
**/out/

# Runtime logs
*.log

# Business artifacts — confidential, local only (Skip directive 2026-04-20)
brain/BusinessArtifacts/

# Local SSL certs — never commit
Code/Shared/ops/certs/


# Test screenshots — generated by Playwright, not source
/test_*.png
/umls_signup.png
Code/ConversationalUX/FindCareChat/backend/tests/test_screenshots/
_oneshots/test_output/

# Caddy binary — downloaded, not source
Code/Shared/ops/tools/caddy.exe

# Analysis videos — large, not source
Analysis/*.mp4

# Conversation log — local dev artifact, contains secrets from session
# conversation_log.json is a brain artifact — DO NOT gitignore
regression_report.json
migrate_dev_to_qa.py
# C# build artifacts
Code/CSharp/**/bin/
Code/CSharp/**/obj/
Code/CSharp/**/build/
brain/machine_artifacts/.iteration_cache/
.langgraph_api/

# Markdown files: dev-only artifacts (Claude scratchpads, audit reports, etc.)
# never served to users; not subject to BR-13 HTTP scan.
*.md

# Archive directories: any "archive" subdir is gitignored at any depth.
# Currently-tracked content under archive/ stays tracked (Skip directive 2026-04-30:
# add the pattern, do NOT clean up the repo). Future additions are ignored.
archive/

# One-shot scratch scripts and dumps. Claude writes any one-shot helper
# (audit script, JSON dump, doc-injector, etc.) into a _oneshots/ dir so
# it never gets caught by pre-commit or accidentally committed.
_oneshots/
**/_oneshots/

# Operational/runtime artifacts (not source)
cls.json
prod_runlog.txt
prod_runlog_stream.txt

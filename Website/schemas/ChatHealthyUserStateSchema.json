{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.chathealthy.ai/schemas/ChatHealthyUserStateSchema.json",
  "title": "ChatHealthy User State",
  "description": "The in-session and post-session representation of a ChatHealthy user, per EPIC-002-F-003-S-005. Aspirational fields (insurance, EMR, financial facts, profile facts) are intentionally retained — they describe the architectural destination for the registered-user profile-load gap (no code currently transfers profile_facts from the registered store into the runtime user_object on OAuth login).",
  "type": "object",
  "required": ["$schema", "user"],
  "properties": {
    "$schema": { "type": "string" },
    "user": {
      "type": "object",
      "required": [
        "current_session_token",
        "expires_at",
        "session_conversation_history"
      ],
      "if": {
        "properties": { "is_registered": { "const": true } },
        "required": ["is_registered"]
      },
      "then": {
        "required": ["OAuthIdentities", "user_id"],
        "properties": {
          "OAuthIdentities": { "minItems": 1 }
        }
      },
      "properties": {
        "current_session_token": {
          "type": "object",
          "description": "Signed wire-envelope security token, restamped on every gate call (new NONCE each time). Shape mirrors chathealthy_lib.authentication.session_token.SessionToken.",
          "required": ["origin", "token", "signature", "created_at", "signed", "server_env"],
          "properties": {
            "origin":     { "type": "string" },
            "token":      { "type": "string", "description": "CH{nonce(35)}{guid(32)} = 69-char string" },
            "signature":  { "type": "string" },
            "created_at": { "type": "string", "format": "date-time" },
            "signed":     { "type": "boolean" },
            "server_env": { "type": "string", "enum": ["local", "dev", "qa", "prod"] }
          }
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "Reset to NOW + 300s on each restamp; canonical 'this session expires at' marker."
        },
        "session_conversation_history": {
          "type": "object",
          "description": "Two parallel threads: human-readable dialogue and machine-readable action log. Each has its own monotonic per-session counter.",
          "required": ["utterances", "actions"],
          "properties": {
            "utterances": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["n", "at", "actor", "text"],
                "properties": {
                  "n":     { "type": "integer", "minimum": 1 },
                  "at":    { "type": "string" },
                  "actor": { "type": "string", "enum": ["person", "system"] },
                  "text":  { "type": "string" }
                }
              }
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["n", "at", "tool_name", "input_json", "output_json"],
                "properties": {
                  "n":           { "type": "integer", "minimum": 1 },
                  "at":          { "type": "string" },
                  "tool_name":   { "type": "string" },
                  "input_json":  { "type": "object" },
                  "output_json": { "type": "object" }
                }
              }
            }
          }
        },
        "is_locked_out": { "type": "boolean" },
        "lockout": {
          "type": "object",
          "description": "Active safety-lockout state, populated by UR's hydration step from {env}_Safety.emergency_incidents. None when no active lockout.",
          "required": ["expires_at", "trigger_utterance"],
          "properties": {
            "expires_at":        { "type": "string", "format": "date-time" },
            "trigger_utterance": { "type": "string" },
            "history":           { "type": "array", "items": { "type": "object" } }
          }
        },
        "silly_question_counts": {
          "type": "object",
          "required": ["session_total", "current_sequence_total"],
          "properties": {
            "session_total":          { "type": "integer", "minimum": 0 },
            "current_sequence_total": { "type": "integer", "minimum": 0 }
          }
        },
        "ip_address": { "type": "string" },
        "is_registered": { "type": "boolean" },
        "user_id": {
          "type": "string",
          "description": "ChatHealthy-minted user identifier. Required when is_registered is true."
        },
        "user_type": {
          "type": "string",
          "enum": ["Guest", "Owner", "Customer", "Prospect"]
        },
        "public_username": { "type": "string" },
        "OAuthIdentities": {
          "type": "array",
          "description": "One entry per identity provider the user has linked. Required (and non-empty) whenever is_registered is true.",
          "items": {
            "type": "object",
            "required": ["identity_provider", "identity_provider_user_id", "email"],
            "properties": {
              "identity_provider":         { "type": "string" },
              "identity_provider_user_id": { "type": "string" },
              "email":                     { "type": "string", "format": "email" }
            },
            "additionalProperties": false
          }
        },
        "registered_profile": {
          "type": "object",
          "description": "Populated when is_registered is true. ARCHITECTURAL TARGET: profile_facts is loaded from the registered-user store on OAuth callback. CURRENT IMPLEMENTATION GAP: no code transfers profile_facts into the runtime user_object yet; the Pydantic shape is authored but never written.",
          "required": ["user_id", "user_type", "oauth_source", "auth_token", "profile_facts"],
          "properties": {
            "user_id":      { "type": "string" },
            "user_type":    { "type": "string", "enum": ["Guest", "Owner", "Customer", "Prospect"] },
            "oauth_source": { "type": "string", "enum": ["Google"] },
            "auth_token":   { "type": "string", "description": "OAuth provider's token, distinct from current_session_token." },
            "profile_facts": {
              "type": "object",
              "required": [
                "gender",
                "sex",
                "age",
                "insurance_info",
                "emr",
                "unstructured_facts",
                "financial_facts"
              ],
              "properties": {
                "gender": {
                  "type": "string",
                  "description": "Free string; default UI choice list TBD pending REQ."
                },
                "sex": {
                  "type": "string",
                  "enum": ["Male", "Female", "Other", "Did not disclose"]
                },
                "age": { "type": "integer", "minimum": 0 },
                "insurance_info": {
                  "type": "object",
                  "required": [
                    "plan",
                    "plan_state",
                    "plan_url",
                    "plan_begin_date",
                    "plan_end_date",
                    "portal_allowed"
                  ],
                  "properties": {
                    "plan":            { "type": "string" },
                    "plan_state":      { "type": "string" },
                    "plan_url":        { "type": "string", "format": "uri" },
                    "plan_begin_date": { "type": "string", "format": "date" },
                    "plan_end_date":   { "type": "string", "format": "date" },
                    "portal_allowed":  { "type": "boolean" },
                    "portal_access": {
                      "type": "object",
                      "description": "Populated when portal_allowed is true.",
                      "required": ["last_update_date", "accumulator_facts", "last_three_claim_eobs", "credentials"],
                      "properties": {
                        "last_update_date": { "type": "string", "format": "date" },
                        "accumulator_facts": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": ["name", "value", "max"],
                            "properties": {
                              "name":  { "type": "string" },
                              "value": { "type": "number" },
                              "max":   { "type": "number" }
                            }
                          }
                        },
                        "last_three_claim_eobs": {
                          "type": "array",
                          "maxItems": 3,
                          "items": {
                            "type": "object",
                            "description": "EOB shape TBD pending REQ."
                          }
                        },
                        "credentials": {
                          "type": "object",
                          "description": "Plan-portal credentials shape TBD pending REQ."
                        }
                      }
                    }
                  }
                },
                "emr": {
                  "type": "object",
                  "required": ["portal_address", "credentials", "fhir_summary_document"],
                  "properties": {
                    "portal_address": { "type": "string", "format": "uri" },
                    "credentials": {
                      "type": "object",
                      "description": "EMR portal credentials shape TBD pending REQ."
                    },
                    "fhir_summary_document": {
                      "type": "object",
                      "description": "FHIR summary document container TBD pending REQ."
                    }
                  }
                },
                "unstructured_facts": {
                  "type": "object",
                  "additionalProperties": true
                },
                "financial_facts": {
                  "type": "object",
                  "required": ["max_spend_out_of_pocket"],
                  "properties": {
                    "max_spend_out_of_pocket": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["condition", "spend_limit"],
                        "properties": {
                          "condition":   { "type": "string" },
                          "spend_limit": { "type": "number" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "not_registered_followup": {
          "type": "object",
          "description": "Populated when is_registered is false.",
          "required": ["has_asked_for_follow_ups"],
          "properties": {
            "has_asked_for_follow_ups": { "type": "boolean" },
            "follow_up_record_id":      { "type": ["string", "null"] }
          }
        },
        "intent": {
          "type": "object",
          "description": "UM-authored IntentDocument carrying the current target_action plus intent entries with their arguments. Shape per ChatHealthyUtteranceManagerOutputSchema.json."
        },
        "selected_providers": {
          "type": "array",
          "description": "NPIs the user has curated from FindCare results for EvaluateCare handoff.",
          "items": { "type": "string" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.chathealthy.ai/schemas/EngineeringRulesSchema.json",
  "title": "ChatHealthy Engineering Rules",
  "description": "Engineering rules with binding statements and runtime enforcements. V17 schema additions: every entry inside rule.enforcements.enforcement[] now carries enforcement_id, hook, executable_path, requires_lock, scopes (optional), and timeout (optional).",
  "type": "object",
  "required": [
    "$schema",
    "rules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "rules": {
      "type": "object",
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "type": "array",
          "minItems": 1,
          "description": "Each rule.id and rule.name MUST be unique across the array. JSON Schema does not natively express cross-record uniqueness; the validator enforces it.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "description",
              "rule_statements",
              "enforcements"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^Rule-\\d{3}$",
                "description": "Sequential, never reused. Format Rule-NNN."
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 101,
                "description": "Unique, human-readable label, <= 101 characters."
              },
              "description": {
                "type": "string",
                "description": "Non-binding prose description of the rule."
              },
              "rule_statements": {
                "type": "object",
                "required": [
                  "rule_statement"
                ],
                "properties": {
                  "rule_statement": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "statement_number",
                        "statement_body",
                        "req_id"
                      ],
                      "properties": {
                        "statement_number": {
                          "type": "integer",
                          "minimum": 1,
                          "description": "Sequential integer starting at 1 within the rule."
                        },
                        "statement_body": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Boolean-testable assertion. The binding rule text."
                        },
                        "req_id": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Reference to the agile_backlog requirement that authorizes this statement."
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              },
              "enforcements": {
                "type": "object",
                "required": [
                  "enforcement"
                ],
                "properties": {
                  "enforcement": {
                    "type": "array",
                    "description": "May be empty when no runtime enforcement is wired yet. When populated, each entry follows the V17 enforcement-entry schema (TR-1 / Table 5).",
                    "items": {
                      "type": "object",
                      "required": [
                        "enforcement_id",
                        "hook",
                        "executable_path",
                        "requires_lock"
                      ],
                      "properties": {
                        "enforcement_id": {
                          "type": "string",
                          "pattern": "^Rule-\\d{3}-ENF-\\d{3}$",
                          "description": "<rule_id>-ENF-NNN, e.g. Rule-065-ENF-006."
                        },
                        "hook": {
                          "type": "string",
                          "enum": [
                            "pre-commit",
                            "commit-msg",
                            "post-commit",
                            "pre-push",
                            "SessionStart",
                            "UserPromptSubmit",
                            "PreToolUse",
                            "Stop",
                            "SessionEnd",
                            "InstructionsLoaded",
                            "PreCompact",
                            "PostCompact"
                          ],
                          "description": "The Git lifecycle or Claude Code hook that fires this enforcement."
                        },
                        "executable_path": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Repo-relative path to the worker script. Manager invokes via subprocess.run([sys.executable, executable_path, enforcement_id], timeout=...)."
                        },
                        "requires_lock": {
                          "type": "boolean",
                          "description": "True if the manager must acquire a lock before dispatching this worker."
                        },
                        "scopes": {
                          "type": "array",
                          "description": "Per-enforcement scope-list rules. Flat list of three-column rows: [function_name: str, scope_list_type: str, list_of_terms: list[str]]. Optional; absent/empty means is_in_scope() falls through to SCOPE_DEFAULT.",
                          "items": {
                            "type": "array",
                            "minItems": 3,
                            "maxItems": 3,
                            "prefixItems": [
                              {
                                "type": "string",
                                "minLength": 1,
                                "description": "function_name — name of a check method on the worker class."
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "allowed_exact",
                                  "allowed_pattern",
                                  "excluded_exact",
                                  "excluded_pattern"
                                ],
                                "description": "scope_list_type — one of the four canonical terms (BR-14)."
                              },
                              {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "description": "list_of_terms — full strings for exact-match types, regex strings for pattern types."
                              }
                            ],
                            "items": false
                          }
                        },
                        "timeout": {
                          "type": "integer",
                          "minimum": 1,
                          "description": "Optional per-worker subprocess timeout in seconds. Manager defaults to DEFAULT_TIMEOUT_SECONDS = 30 when omitted."
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

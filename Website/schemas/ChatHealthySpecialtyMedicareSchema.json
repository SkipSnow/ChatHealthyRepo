                  "min": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Smallest value greater than zero -- a 0 is not a min; zero values are excluded. Null when no non-zero value exists."
                  },
                  "median": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "The middle value (statistical median)."
                  },
                  "avg": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "The sum divided by the count."
                  }
                }
              },
              "tot_day_suply": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "max",
                  "min",
                  "median",
                  "avg"
                ],
                "properties": {
                  "max": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "min": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Smallest value greater than zero -- a 0 is not a min; zero values are excluded. Null when no non-zero value exists."
                  },
                  "median": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "The middle value (statistical median)."
                  },
                  "avg": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "The sum divided by the count."
                  }
                }
              },
              "tot_drug_cst": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "max",
                  "min",
                  "median",
                  "avg"
                ],
                "properties": {
                  "max": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "min": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Smallest value greater than zero -- a 0 is not a min; zero values are excluded. Null when no non-zero value exists."
                  },
                  "median": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "The middle value (statistical median)."
                  },
                  "avg": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "The sum divided by the count."
                  }
                }
              }
            }
          },
          "prescriber_count": {
            "type": "integer",
            "description": "Distinct providers of this NUCC prescribing this molecule."
          }
        }
      }
    },
    "provider_count": {
      "type": "integer",
      "description": "Providers carrying this NUCC in any taxonomy slot (Provider_v_5)."
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregated_from",
        "run_id",
        "built_at"
      ],
      "properties": {
        "aggregated_from": {
          "type": "array",
          "items": {

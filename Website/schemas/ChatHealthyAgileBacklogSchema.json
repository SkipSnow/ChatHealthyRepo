{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.chathealthy.ai/schemas/ChatHealthyAgileBacklogSchema.json",
  "title": "ChatHealthy Agile Backlog",
  "description": "All epics, features, stories, and boolean testable requirements for ChatHealthy.ai LLC.",
  "type": "object",
  "required": [
    "$schema",
    "epics"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "collection": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "created": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "sprint_map": {
      "type": "array"
    },
    "orphan_catchall": {
      "type": "object"
    },
    "epics": {
      "type": "object",
      "required": [
        "epic"
      ],
      "properties": {
        "epic": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "Top-level business component. Contains features. Creation requires human authority.",
            "required": [
              "epic_id",
              "name",
              "status",
              "description",
              "features",
              "orphan",
              "approval"
            ],
            "properties": {
              "epic_id": {
                "type": "string",
                "pattern": "^EPIC-\\d{3}$",
                "description": "Sequential, assigned by Claude. Never reused."
              },
              "name": {
                "type": "string",
                "description": "Human-readable business component name (per v4-030)."
              },
              "type": {
                "type": "string",
                "enum": [
                  "operational",
                  "functional"
                ],
                "description": "operational = user-facing product capability. functional = business function."
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_started",
                  "in_progress",
                  "done",
                  "done_known_issue",
                  "to_test",
                  "blocked",
                  "deferred"
                ],
                "description": "Work lifecycle status. Constrained by CV-005."
              },
              "description": {
                "type": "string"
              },
              "capacity": {
                "type": "string"
              },
              "goal": {
                "type": "string"
              },
              "definition_of_done": {
                "type": "string"
              },
              "orphan": {
                "type": "boolean",
                "description": "True if this item does not yet have a proper home in the hierarchy."
              },
              "approval": {
                "type": "string",
                "enum": [
                  "approved",
                  "proposed",
                  "rejected"
                ],
                "description": "human approval status. Constrained by CV-011."
              },
              "features": {
                "type": "object",
                "required": [
                  "feature"
                ],
                "properties": {
                  "feature": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "description": "A capability within an epic. Contains stories.",
                      "required": [
                        "feature_id",
                        "name",
                        "status",
                        "stories",
                        "orphan",
                        "approval",
                        "due_date",
                        "delivery_date"
                      ],
                      "properties": {
                        "feature_id": {
                          "type": "string",
                          "description": "Short uppercase identifier."
                        },
                        "name": {
                          "type": "string"
                        },
                        "epic_id": {
                          "type": "string"
                        },
                        "layer": {
                          "type": "string"
                        },
                        "capability": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "in_progress",
                            "done",
                            "done_known_issue",
                            "to_test",
                            "blocked",
                            "deferred"
                          ],
                          "description": "Constrained by CV-005."
                        },
                        "description": {
                          "type": "string"
                        },
                        "evidence": {
                          "type": "string"
                        },
                        "priority": {
                          "type": "string"
                        },
                        "accepted_by": {
                          "type": "string"
                        },
                        "backend_dependencies": {
                          "type": "array"
                        },
                        "realized_by": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "orphan": {
                          "type": "boolean"
                        },
                        "approval": {
                          "type": "string",
                          "enum": [
                            "approved",
                            "proposed",
                            "rejected"
                          ]
                        },
                        "stories": {
                          "type": "object",
                          "required": [
                            "story"
                          ],
                          "properties": {
                            "story": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "description": "A unit of deliverable work within a feature. Contains requirements.",
                                "required": [
                                  "story_id",
                                  "name",
                                  "description",
                                  "size",
                                  "status",
                                  "requirements",
                                  "orphan",
                                  "approval"
                                ],
                                "properties": {
                                  "story_id": {
                                    "type": "string"
                                  },
                                  "name": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 200,
                                    "description": "Human-readable label (single label across all hierarchy levels per ARCH-SCAN-JSON-REQ-003)."
                                  },
                                  "description": {
                                    "type": "string"
                                  },
                                  "size": {
                                    "type": "string",
                                    "enum": [
                                      "S",
                                      "M",
                                      "L",
                                      "XL"
                                    ]
                                  },
                                  "status": {
                                    "type": "string",
                                    "enum": [
                                      "not_started",
                                      "in_progress",
                                      "done",
                                      "done_known_issue",
                                      "to_test",
                                      "blocked",
                                      "deferred"
                                    ]
                                  },
                                  "code_controlled": {
                                    "type": "boolean"
                                  },
                                  "code_references": {
                                    "type": "array"
                                  },
                                  "orphan": {
                                    "type": "boolean"
                                  },
                                  "approval": {
                                    "type": "string",
                                    "enum": [
                                      "approved",
                                      "proposed",
                                      "rejected"
                                    ]
                                  },
                                  "requirements": {
                                    "type": "object",
                                    "required": [
                                      "requirement"
                                    ],
                                    "properties": {
                                      "requirement": {
                                        "type": "array",
                                        "items": {
                                          "type": "object",
                                          "description": "A boolean-testable assertion. Contains pytest children.",
                                          "required": [
                                            "req_id",
                                            "name",
                                            "requirement",
                                            "priority",
                                            "status",
                                            "pytests",
                                            "orphan",
                                            "approval"
                                          ],
                                          "properties": {
                                            "req_id": {
                                              "type": "string"
                                            },
                                            "name": {
                                              "type": "string",
                                              "minLength": 1,
                                              "maxLength": 200,
                                              "description": "Human-readable label (single label across all hierarchy levels per ARCH-SCAN-JSON-REQ-003)."
                                            },
                                            "requirement": {
                                              "type": "string"
                                            },
                                            "priority": {
                                              "type": "string",
                                              "enum": [
                                                "must-have",
                                                "should-have",
                                                "nice-to-have"
                                              ]
                                            },
                                            "status": {
                                              "type": "string",
                                              "enum": [
                                                "not_started",
                                                "in_progress",
                                                "done",
                                                "done_known_issue",
                                                "to_test",
                                                "blocked",
                                                "deferred"
                                              ]
                                            },
                                            "bug_ids": {
                                              "type": "array",
                                              "items": {
                                                "type": "string"
                                              }
                                            },
                                            "realized_by": {
                                              "type": "array",
                                              "items": {
                                                "type": "string"
                                              }
                                            },
                                            "depends_on": {
                                              "type": "array",
                                              "items": {
                                                "type": "object",
                                                "properties": {
                                                  "story_id": {
                                                    "type": "string"
                                                  },
                                                  "reason": {
                                                    "type": "string"
                                                  }
                                                },
                                                "additionalProperties": false
                                              }
                                            },
                                            "orphan": {
                                              "type": "boolean"
                                            },
                                            "approval": {
                                              "type": "string",
                                              "enum": [
                                                "approved",
                                                "proposed",
                                                "rejected"
                                              ]
                                            },
                                            "source": {
                                              "type": "string"
                                            },
                                            "story_id": {
                                              "type": "string"
                                            },
                                            "resolution_status": {
                                              "type": "string"
                                            },
                                            "pytests": {
                                              "type": "object",
                                              "required": [
                                                "pytest"
                                              ],
                                              "properties": {
                                                "pytest": {
                                                  "type": "array",
                                                  "minItems": 1,
                                                  "maxItems": 2,
                                                  "items": {
                                                    "type": "object",
                                                    "description": "A test that validates a requirement.",
                                                    "required": [
                                                      "pytest_id",
                                                      "pytest_type",
                                                      "orphan"
                                                    ],
                                                    "properties": {
                                                      "pytest_id": {
                                                        "type": "string",
                                                        "description": "Reference to the pytest function or file."
                                                      },
                                                      "pytest_type": {
                                                        "type": "string",
                                                        "enum": [
                                                          "playwright",
                                                          "ordinary",
                                                          "unit",
                                                          "integration",
                                                          "analysis",
                                                          "ORPHAN"
                                                        ]
                                                      },
                                                      "file": {
                                                        "type": "string"
                                                      },
                                                      "orphan": {
                                                        "type": "boolean"
                                                      }
                                                    },
                                                    "additionalProperties": false
                                                  }
                                                }
                                              },
                                              "additionalProperties": false
                                            }
                                          },
                                          "additionalProperties": false
                                        }
                                      }
                                    },
                                    "additionalProperties": false
                                  }
                                },
                                "additionalProperties": false
                              }
                            }
                          },
                          "additionalProperties": false
                        },
                        "due_date": {
                          "type": "string"
                        },
                        "delivery_date": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

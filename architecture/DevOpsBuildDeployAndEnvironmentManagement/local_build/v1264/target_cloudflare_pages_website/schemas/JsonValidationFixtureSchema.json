{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.chathealthy.ai/schemas/JsonValidationFixtureSchema.json",
  "title": "JSON Validation Fixture Schema",
  "description": "Tiny schema used by the JSON-validation negative-test fixtures (V17 §4.10.3).",
  "type": "object",
  "required": [
    "$schema",
    "name",
    "kind"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "alpha",
        "beta",
        "gamma"
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}

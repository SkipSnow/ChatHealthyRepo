FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# F-003 §7: bake CA PEMs into the image at build time (no runtime KV for CA).
ARG CHATHEALTHY_CA_ROOT_B64
ARG CHATHEALTHY_CA_INTERMEDIATE_B64
RUN test -n "$CHATHEALTHY_CA_ROOT_B64" \
 && test -n "$CHATHEALTHY_CA_INTERMEDIATE_B64" \
 && mkdir -p /etc/chathealthy/ca \
 && printf '%s' "$CHATHEALTHY_CA_ROOT_B64" | base64 -d > /etc/chathealthy/ca/root.pem \
 && printf '%s' "$CHATHEALTHY_CA_INTERMEDIATE_B64" | base64 -d > /etc/chathealthy/ca/intermediate.pem \
 && grep -q "BEGIN CERTIFICATE" /etc/chathealthy/ca/root.pem \
 && grep -q "BEGIN CERTIFICATE" /etc/chathealthy/ca/intermediate.pem

COPY pipeline/requirements-pipeline.txt /app/pipeline/
RUN pip install --no-cache-dir -r pipeline/requirements-pipeline.txt \
    && pip install --no-cache-dir azure-identity azure-keyvault-secrets

COPY ChatHealthyLib /app/ChatHealthyLib
RUN pip install --no-cache-dir /app/ChatHealthyLib

# Scoped Medicare worker image: same closure as the controller -- run_lifecycle,
# provider_base (shared ingest engines the Medicare steps call: fetch_all_sources,
# load_staging, archive_sources, PipelineRuntime), and the Medicare pipeline.
# provider_enrichment / provider_pipeline / data_release are excluded; the step
# registry attempts their module paths at boot and skips each absence with a
# WARNING (steps/__init__), by design.
COPY pipeline/__init__.py /app/pipeline/__init__.py
COPY pipeline/run_lifecycle /app/pipeline/run_lifecycle
COPY pipeline/provider_base /app/pipeline/provider_base
COPY pipeline/MedicareProviderEvaluationDataPipeline /app/pipeline/MedicareProviderEvaluationDataPipeline

# Segregation (operator ruling 2026-10-22): the worker image cannot do the
# controller's job. The controller entry program, its status listener, the
# orchestration machinery, the controller-release module and the
# automation-side programs are removed; tests, operator tools and stray
# Dockerfiles do not ship. aca_job_manager stays: the quiesce step (a worker
# work item) imports it.
RUN rm /app/pipeline/MedicareProviderEvaluationDataPipeline/control_runner.py \
       /app/pipeline/MedicareProviderEvaluationDataPipeline/medicare_orchestrator.py \
       /app/pipeline/run_lifecycle/run_status_server.py \
       /app/pipeline/run_lifecycle/controller_release.py \
       /app/pipeline/run_lifecycle/base_pipeline_orchestrator.py \
       /app/pipeline/run_lifecycle/controller_phase.py \
       /app/pipeline/run_lifecycle/worker_vm_provisioning.py \
       /app/pipeline/run_lifecycle/worker_pid_verifier.py \
       /app/pipeline/run_lifecycle/pipeline_runbook.py \
       /app/pipeline/run_lifecycle/watchdog_runbook.py \
       /app/pipeline/run_lifecycle/reservation_reaper.py \
       /app/pipeline/run_lifecycle/runbook_bootstrap.py \
       /app/pipeline/run_lifecycle/report_controller_failure.py \
    && rm -rf /app/pipeline/run_lifecycle/tests /app/pipeline/run_lifecycle/ops \
       /app/pipeline/provider_base/tests \
       /app/pipeline/MedicareProviderEvaluationDataPipeline/tests \
       /app/pipeline/run_lifecycle/Dockerfile.control \
       /app/pipeline/run_lifecycle/Dockerfile.worker \
       /app/pipeline/MedicareProviderEvaluationDataPipeline/Dockerfile.medicare-control \
       /app/pipeline/MedicareProviderEvaluationDataPipeline/Dockerfile.medicare-worker

# The committed JSON Schema contracts of the published collections. The store
# enforces conformance (LLD v83 I.3.12): the clear-and-index step reads the
# ProviderMedicare and SpecialtyMedicare contracts from here and installs each
# on its collection as that collection's MongoDB validator
# (medicare_store_contract PUBLISHED_CONTRACTS). Only the contracts ship --
# not the firm's whole schema directory.
COPY Website/schemas/ChatHealthyProviderMedicareSchema.json /app/Website/schemas/
COPY Website/schemas/ChatHealthySpecialtyMedicareSchema.json /app/Website/schemas/
COPY Website/schemas/ChatHealthyFdaProductToDiagnosisResolutionSchema.json /app/Website/schemas/
COPY brain/machine_artifacts/content/pipeline_config.json /app/brain/machine_artifacts/content/pipeline_config.json
COPY brain/machine_artifacts/content/pipeline_indexes.json /app/brain/machine_artifacts/content/pipeline_indexes.json
COPY brain/machine_artifacts/content/pipeline_index_packages.json /app/brain/machine_artifacts/content/pipeline_index_packages.json

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "pipeline/run_lifecycle/bootstrap.py", "pipeline/run_lifecycle/pipeline_worker.py"]

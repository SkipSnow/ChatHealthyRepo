FROM python:3.12-slim

WORKDIR /app/pipeline/Code

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# F-003 §7: bake CA PEMs into the image at build time (no runtime KV for CA).
ARG CHATHEALTHY_CA_ROOT_B64
ARG CHATHEALTHY_CA_INTERMEDIATE_B64
RUN test -n "$CHATHEALTHY_CA_ROOT_B64" \
 && test -n "$CHATHEALTHY_CA_INTERMEDIATE_B64" \
 && mkdir -p /etc/chathealthy/ca \
 && printf '%s' "$CHATHEALTHY_CA_ROOT_B64" | base64 -d > /etc/chathealthy/ca/root.pem \
 && printf '%s' "$CHATHEALTHY_CA_INTERMEDIATE_B64" | base64 -d > /etc/chathealthy/ca/intermediate.pem \
 && grep -q "BEGIN CERTIFICATE" /etc/chathealthy/ca/root.pem \
 && grep -q "BEGIN CERTIFICATE" /etc/chathealthy/ca/intermediate.pem

COPY pipeline/Code/requirements-pipeline.txt /app/pipeline/Code/
RUN pip install --no-cache-dir -r requirements-pipeline.txt \
    && pip install --no-cache-dir azure-identity azure-keyvault-secrets

COPY FrontEndApplicationLib /app/FrontEndApplicationLib
RUN pip install --no-cache-dir /app/FrontEndApplicationLib

COPY pipeline/Code /app/pipeline/Code/

# Brain metadata (single source of truth per operator directive 2026-07-31).
# pipeline_config.py resolves this file relative to its own location, so
# the /app/brain/... path here must match parents[2] of pipeline/Code/.
COPY brain/machine_artifacts/content/pipeline_config.json /app/brain/machine_artifacts/content/pipeline_config.json

ENV PYTHONPATH=/app/pipeline/Code
ENV PYTHONUNBUFFERED=1

# bootstrap fetches Key Vault secrets → env vars, then exec's control_runner.py
ENTRYPOINT ["python", "bootstrap.py", "control_runner.py"]

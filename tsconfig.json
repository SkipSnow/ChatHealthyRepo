{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "sharedServices/Code/*"
      ],
      "@providers/*": [
        "FindCare/ProviderManagement/*"
      ],
      "@findcare/*": [
        "FindCare/*"
      ]
    }
  },
  "include": [
    "Website/FindCareChat/src",
    "FindCare/**/*.tsx",
    "FindCare/**/*.ts",
    "sharedServices/Code/**/*.tsx",
    "sharedServices/Code/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/build",
    "Website/functions"
  ]
}
